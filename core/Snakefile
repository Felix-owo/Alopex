                bai = CELL_PATH_PATTERN.rna_bam_index
            log:
                LOGS_DIR / "rules/bismark/{demux_sample}_rna_bam.log"
            threads: HIGH_CPH_BAM_THREADS
            resources:
                mem_mb = lambda wildcards, attempt: static_resource_mem_mb(
                    "high_cph_bam", wildcards.demux_sample, attempt
                ),
                runtime = lambda wildcards, attempt: static_resource_runtime_min(
                    "high_cph_bam", wildcards.demux_sample, attempt
                ),
                attempt_no = lambda wildcards, attempt: int(attempt)
            params:
                samtools = SAMTOOLS,
                resource_log = lambda wc: static_resource_log("high_cph_bam", wc.demux_sample),
            conda: ENVIRONMENT_YAML
            shell:
                r"""
                set -euo pipefail
                source {JOB_RUNTIME:q}
                mkdir -p "$(dirname {log:q})"
                dna_pipeline_init_attempt_logs {resources.attempt_no} {log:q}
                printf '%s attempt=%s threads=%s mem_mb=%s runtime_min=%s\n' \
                    {params.resource_log:q} {resources.attempt_no} {threads} \
                    {resources.mem_mb} {resources.runtime} >> {log:q}
                tmp_bam={output.bam:q}.tmp.$$
                tmp_bai="$tmp_bam.bai"
                trap 'rm -f -- "$tmp_bam" "$tmp_bai"' EXIT
                sam_extra=$(({threads} > 1 ? {threads} - 1 : 0))
                dna_pipeline_coordinate_sort_and_stage \
                    {params.samtools:q} "$sam_extra" {input.bam:q} \
                    "$tmp_bam" "$tmp_bai" \
                    {output.bam:q} {output.bai:q} >> {log:q} 2>&1
                rm -f -- "$tmp_bam" "$tmp_bai"
                trap - EXIT
                """
    rule bismark_extract:
        """直接在 pair-adjacent 过滤 BAM 上运行 Bismark methylation extraction，产出合并 cov、M-bias 与报告。"""
        group: "bismark_cell" if PROTOCOL_POLICY.name in {"cabernet", "droplet"} else None
        input:
            demux_completion = current_demux_completion,
            bam = BISMARK_ANALYSIS_BAM
        output:
            cov = temp(CELL_PATH_PATTERN.bismark_cov),
            extract_report = CELL_PATH_PATTERN.bismark_extract_report,
            mbias = CELL_PATH_PATTERN.bismark_mbias
        log:
            LOGS_DIR / "rules/bismark/{demux_sample}_extract.log"
        threads: BISMARK_EXTRACT_THREADS
        resources:
            mem_mb = lambda wildcards, attempt: backend_stage_mem_mb(
                "bismark", "extract", wildcards.demux_sample, attempt
            ),
            runtime = lambda wildcards, attempt: BISMARK_CELL_RULE_RUNTIME_MIN if PROTOCOL_POLICY.name in {"cabernet", "droplet"} else backend_stage_runtime_min(
                "bismark", "extract", wildcards.demux_sample, attempt
            ),
            disk_mb = lambda wildcards: static_scratch_mb(
                "bismark_extract", wildcards.demux_sample
            ),
            attempt_no = lambda wildcards, attempt: int(attempt)
        params:
            bismark = BISMARK,
            samtools = SAMTOOLS,
            local_tmp = NODE_TMPDIR,
            scratch_namespace = SCRATCH_NAMESPACE,
            resource_log = lambda wc: static_resource_log(
                "bismark_extract", wc.demux_sample
            )
        conda: ENVIRONMENT_YAML
        shell:
            r"""
            set -euo pipefail
            source {JOB_RUNTIME:q}
            mkdir -p "$(dirname {output.cov:q})" "$(dirname {log:q})"
            dna_pipeline_init_attempt_logs {resources.attempt_no} {log:q}
            printf '%s attempt=%s threads=%s mem_mb=%s runtime_min=%s scratch_mb=%s\n' \
                {params.resource_log:q} {resources.attempt_no} {threads} \
                {resources.mem_mb} {resources.runtime} {resources.disk_mb} >> {log:q}
            exec 2>> {log:q}
            dna_pipeline_allocate_scratch \
                {params.local_tmp:q} {params.scratch_namespace:q} \
                bismark_extract \
                {wildcards.demux_sample:q} {resources.disk_mb} {PROJECT_DIR:q}
            dna_pipeline_install_scratch_cleanup
            tmp="$DNA_PIPELINE_SCRATCH_DIR"
            out="$tmp/out"
            mkdir -p "$out"
            dna_pipeline_log_scratch >> {log:q} 2>&1

            {params.samtools:q} quickcheck -v {input.bam:q} >> {log:q} 2>&1

            echo "INFO: stage=bismark_extract allocated_threads={threads} parallel=1" >> {log:q}

            {params.bismark:q} extract \
                --gzip --bedGraph --comprehensive --parallel 1 \
                --output_dir "$out" \
                {input.bam:q} >> {log:q} 2>&1
            cov=$(dna_pipeline_find_single_output "$out" '*.bismark.cov.gz')
            extract_report=$(dna_pipeline_find_single_output "$out" '*splitting_report.txt')
            mbias=$(dna_pipeline_find_single_output "$out" '*M-bias.txt')
            {GZIP:q} -t "$cov" >> {log:q} 2>&1
            test -s "$extract_report"
            test -s "$mbias"

            python -m dna_pipeline atomic-publish \
                --commit-last {output.cov:q} \
                --file "$extract_report" {output.extract_report:q} \
                --file "$mbias" {output.mbias:q} \
                --file "$cov" {output.cov:q} \
                >> {log:q} 2>&1
            dna_pipeline_release_scratch
            """
    rule bismark_cpg:
        """将 Bismark observed coverage 直接流式转换为 SnapATAC2 import_values 四列 CpG 格式。"""
        group: "bismark_cell" if PROTOCOL_POLICY.name in {"cabernet", "droplet"} else None
        input:
            demux_completion = current_demux_completion,
            cov = rules.bismark_extract.output.cov
        output:
            cpg = CELL_PATH_PATTERN.cpg
        log:
            LOGS_DIR / "rules/bismark/{demux_sample}_cpg.log"
        threads: CPG_THREADS
        resources:
            mem_mb = lambda wildcards, attempt: static_resource_mem_mb(
                "generate_cpg_input", wildcards.demux_sample, attempt
            ),
            runtime = lambda wildcards, attempt: BISMARK_CELL_RULE_RUNTIME_MIN if PROTOCOL_POLICY.name in {"cabernet", "droplet"} else static_resource_runtime_min(
                "generate_cpg_input", wildcards.demux_sample, attempt
            ),
            attempt_no = lambda wildcards, attempt: int(attempt)
        params:
            zstd = ZSTD,
            gzip = GZIP,
            resource_log = lambda wc: static_resource_log(
                "generate_cpg_input", wc.demux_sample
            )
        conda: ENVIRONMENT_YAML
        shell:
            r"""
            set -euo pipefail
            source {JOB_RUNTIME:q}
            mkdir -p "$(dirname {output.cpg:q})" "$(dirname {log:q})"
            dna_pipeline_init_attempt_logs {resources.attempt_no} {log:q}
            printf '%s attempt=%s threads=%s mem_mb=%s runtime_min=%s\n' \
                {params.resource_log:q} {resources.attempt_no} {threads} {resources.mem_mb} {resources.runtime} \
                >> {log:q}
            exec 2>> {log:q}

            tmp_cpg={output.cpg:q}.tmp.$$.zst
            cleanup_cpg_tmp() {{ rm -f -- "$tmp_cpg"; }}
            trap cleanup_cpg_tmp EXIT
            {params.gzip:q} -t {input.cov:q}
            {params.gzip:q} -dc {input.cov:q} | \
                dna_pipeline_emit_canonical_cpg {params.zstd:q} -1 "$tmp_cpg"
            {params.zstd:q} -q -t "$tmp_cpg"
            python -m dna_pipeline atomic-publish \
                --commit-last {output.cpg:q} \
                --file "$tmp_cpg" {output.cpg:q} \
                >> {log:q} 2>&1
            rm -f -- "$tmp_cpg"
            trap - EXIT
            """
localrules: initial_cell_manifest, demux_completion_barrier, multiqc, final_sample_manifest, delivery_ready

DEMUX_COMPLETION_TARGETS = expand(
    [str(path) for path in rules.demux.output],
    sample=DEMUX_RUN_IDS,
)
DEMUX_COMPLETION_BARRIER = INTERMEDIATE_DIR / "markers" / "demux_completions.done"


def current_pipeline_output_targets(wildcards):
    for run_id in DEMUX_RUN_IDS:
        checkpoints.demux.get(sample=run_id)
    return get_staged_delivery_targets()


FINAL_SAMPLE_PAIR_QC = INTERMEDIATE_DIR / "multiqc" / "pair_level_qc_mqc.json"
FINAL_SAMPLE_CUTADAPT_QC = (
    INTERMEDIATE_DIR / "multiqc" / "cutadapt_r1r2_qc_mqc.json"
)


def current_multiqc_source_inputs(wildcards):
    sources = []
    for run_id in DEMUX_RUN_IDS:
        checkpoint_output = checkpoints.demux.get(sample=run_id).output
        sources.append(str(checkpoint_output.json_mqc))

    active_samples = get_demuxed_samples()
    for sample in active_samples:
        paths = PROJECT_LAYOUT.cell(sample)
        sources.append(str(paths.cutadapt_json))
        if METHYLATION_BACKEND == "biscuit":
            sources.append(str(paths.dupsifter_multiqc))
            sources.append(str(paths.high_cph_multiqc if paths.high_cph_multiqc.is_file() else paths.high_cph_summary))
            sources.extend(
                str(path)
                for path in paths.biscuit_qc_sources(
                    MULTIQC_BISCUIT_SOURCE_SUFFIXES
                )
            )
        elif METHYLATION_BACKEND == "bismark":
            sources.extend(
                [
                    str(paths.bismark_align_report),
                    str(paths.bismark_extract_report),
                    str(paths.bismark_mbias),
                ]
            )
            sources.append(str(paths.high_cph_multiqc if paths.high_cph_multiqc.is_file() else paths.high_cph_summary))
            if PROTOCOL_POLICY.name != "droplet":
                sources.append(str(paths.bismark_dedup_report))
    sources.extend([
        str(FINAL_SAMPLE_PAIR_QC),
        str(FINAL_SAMPLE_CUTADAPT_QC),
    ])
    return sources


def current_final_manifest_qc_inputs(wildcards):
    for run_id in DEMUX_RUN_IDS:
        checkpoints.demux.get(sample=run_id)
    active_samples = get_demuxed_samples()
    inputs = []
    for sample in active_samples:
        paths = PROJECT_LAYOUT.cell(sample)
        inputs.append(str(paths.cutadapt_json))
        if KEEP_FINAL_BAM:
            inputs.extend(map(str, paths.retained_bam_files))
        if METHYLATION_BACKEND == "rastair":
            inputs.append(str(paths.rastair_qc))
            continue
        inputs.append(str(paths.high_cph_summary))
        if METHYLATION_BACKEND == "biscuit":
            inputs.extend(
                [
                    str(paths.dupsifter_multiqc),
                    str(paths.biscuit_qc_source("CpHRetentionByReadPos.txt")),
                ]
            )
        else:
            inputs.extend(
                [
                    str(paths.droplet_umi_qc if PROTOCOL_POLICY.name == "droplet" else paths.bismark_dedup_report),
                    str(paths.bismark_align_report),
                    str(paths.bismark_extract_report),
                    str(paths.bismark_mbias),
                ]
            )
    return inputs


def current_rna_bam_inputs(wildcards):
    if not PUBLISH_RNA_BAM:
        return []
    inputs = []
    for sample in get_demuxed_samples():
        paths = PROJECT_LAYOUT.cell(sample)
        inputs.extend([str(paths.rna_bam), str(paths.rna_bam_index)])
    return inputs


def current_rna_fastq_inputs(wildcards):
    if not PROTOCOL_POLICY.requires_rna_barcode:
        return []
    return [
        str(RNA_COLLECT_DIR / f"{run_id}.json")
        for run_id in DEMUX_RUN_IDS
    ]


rule multiqc:
    """生成 MultiQC 文件清单，并基于 --file-list 运行 MultiQC，把 HTML 报告以同文件系统原子 rename 发布到 staged QC 目录。"""
    input:
        sources = current_multiqc_source_inputs,
        pair_qc = FINAL_SAMPLE_PAIR_QC,
        cutadapt_qc = FINAL_SAMPLE_CUTADAPT_QC,
    output:
        report = STAGED_RESULTS_DIR / "QC_Results" / "multiqc_report.html",
        file_list = temp(INTERMEDIATE_DIR / "multiqc" / "multiqc_sources.txt"),
        high_cph = temp(INTERMEDIATE_DIR / "multiqc" / "high_cph_rebuilt_mqc.json"),
    log:
        LOGS_DIR / "rules/multiqc.log"
    threads: MULTIQC_THREADS
    conda: ENVIRONMENT_YAML
    resources:
        mem_mb = lambda wildcards, attempt: static_resource_mem_mb(
            "multiqc", None, attempt
        ),
        runtime = lambda wildcards, attempt: static_resource_runtime_min(
            "multiqc", None, attempt
        ),
        attempt_no = lambda wildcards, attempt: int(attempt)
    params:
        outdir = STAGED_RESULTS_DIR / "QC_Results",
        tmpout = INTERMEDIATE_DIR / "multiqc" / "output_tmp",
        multiqc = MULTIQC,
        resource_log = lambda wc: static_resource_log("multiqc")
    run:
        shell("source {JOB_RUNTIME:q}; dna_pipeline_init_attempt_logs {resources.attempt_no} {log:q}")
        count, skipped = write_multiqc_file_list(
            prepare_high_cph_multiqc_sources(
                list(input.sources) + [str(input.pair_qc), str(input.cutadapt_qc)],
                Path(output.high_cph),
            ),
            str(output.file_list),
        )
        with open(str(log), "a", encoding="utf-8") as handle:
            handle.write(f"INFO: multiqc_sources={count}\n")
            for item in skipped:
                handle.write(f"WARNING: skipped_multiqc_source={item}\n")
        shell(
            r"""
            set -euo pipefail
            source {JOB_RUNTIME:q}
            mkdir -p {params.outdir:q} "$(dirname {log:q})" "$(dirname {params.tmpout:q})"
            printf '%s attempt=%s threads=%s mem_mb=%s runtime_min=%s\n' \
                {params.resource_log:q} {resources.attempt_no} {threads} \
                {resources.mem_mb} {resources.runtime} >> {log:q}

            tmpout={params.tmpout:q}.attempt{resources.attempt_no}.$$
            report_partial={output.report:q}.partial.$$
            cleanup_multiqc_tmp() {{
                rm -rf -- "$tmpout"
                rm -f -- "$report_partial"
            }}
            trap cleanup_multiqc_tmp EXIT
            mkdir -p "$tmpout"

            {params.multiqc:q} -f \
                -o "$tmpout" \
                -n multiqc_report.html \
                --file-list {output.file_list:q} \
                >> {log:q} 2>&1

            test -s "$tmpout/multiqc_report.html"
            cp "$tmpout/multiqc_report.html" "$report_partial"
            test -s "$report_partial"

            mv "$report_partial" {output.report:q}
            rm -rf -- "$tmpout"
            trap - EXIT
            """
        )


rule final_sample_manifest:
    """汇总全部 staged deliverable 与逐细胞 QC 工件，生成公开 sample manifest 及配套 presentation-only QC JSON。"""
    input:
        trigger = DEMUX_COMPLETION_BARRIER,
        deliverables = current_pipeline_output_targets,
        qc_artifacts = current_final_manifest_qc_inputs,
        rna_bams = current_rna_bam_inputs,
        rna_fastq_markers = current_rna_fastq_inputs,
        initial_manifest = rules.initial_cell_manifest.output.manifest
    output:
        manifest = STAGED_RESULTS_DIR / "QC_Results" / "sample_manifest.tsv",
        pair_qc = temp(FINAL_SAMPLE_PAIR_QC),
        cutadapt_qc = temp(FINAL_SAMPLE_CUTADAPT_QC)
    log:
        LOGS_DIR / "rules/final_sample_manifest.log"
    conda: ENVIRONMENT_YAML
    resources:
        mem_mb = lambda wildcards, attempt: controller_resource_mem_mb(
            "final_sample_manifest", attempt
        ),
        runtime = lambda wildcards, attempt: controller_resource_runtime_min(
            "final_sample_manifest", attempt
        )
    params:
        bismark = BISMARK,
        initial_manifest = lambda wc, input: str(input.initial_manifest),
        intermediate = str(INTERMEDIATE_DIR),
        staged_results = str(STAGED_RESULTS_DIR),
        published_results = str(PUBLIC_RESULTS_DIR),
        options_json = json.dumps(
            {
                "methylation_backend": METHYLATION_BACKEND,
                "generate_snp": GENERATE_SNP,
                "keep_final_bam": KEEP_FINAL_BAM,
                "publish_rna_bam": PUBLISH_RNA_BAM,
            },
            sort_keys=True,
            separators=(",", ":"),
        )
    shell:
        r"""
        set -euo pipefail
        export PYTHONPATH="$DNA_PIPELINE_ROOT/core"
        mkdir -p "$(dirname {output.manifest:q})" "$(dirname {log:q})"
        python -m dna_pipeline write-sample-manifest \
            {params.initial_manifest:q} \
            {params.intermediate:q} \
            {params.staged_results:q} \
            {params.published_results:q} \
            {output.manifest:q} \
            {output.pair_qc:q} \
            {output.cutadapt_qc:q} \
            --bismark {params.bismark:q} \
            --options-json {params.options_json:q} > {log:q} 2>&1
        """


rule delivery_ready:
    """按最终 manifest 声明的产物记录一次 inventory，拒绝缺失文件并写入 delivery_ready 发布边界。"""
    input:
        multiqc_report = rules.multiqc.output.report,
        sample_manifest = rules.final_sample_manifest.output.manifest,
        deliverables = current_pipeline_output_targets,
        run_snapshot = RUN_SNAPSHOT_DEP
    output:
        ready = DELIVERY_READY
    log:
        LOGS_DIR / "rules/delivery_ready.log"
    conda: ENVIRONMENT_YAML
    resources:
        mem_mb = lambda wildcards, attempt: controller_resource_mem_mb(
            "delivery_ready", attempt
        ),
        runtime = lambda wildcards, attempt: controller_resource_runtime_min(
            "delivery_ready", attempt
        )
    params:
        staged_results = str(STAGED_RESULTS_DIR),
        run_snapshot = str(PROVENANCE_SNAPSHOT_PATH or ""),
    shell:
        r"""
        set -euo pipefail
        export PYTHONPATH="$DNA_PIPELINE_ROOT/core"
        mkdir -p "$(dirname {output.ready:q})" "$(dirname {log:q})"
        python -m dna_pipeline delivery-ready \
            --ready {output.ready:q} \
            --staged-results {params.staged_results:q} \
            --run-snapshot {params.run_snapshot:q} > {log:q} 2>&1
        """


rule demux_completion_barrier:
    """等待全部 raw run 的 manifest、report、展示 JSON 与 completion 完整后落 marker，缺一项即重跑该 demux。"""
    input:
        DEMUX_COMPLETION_TARGETS
    output:
        touch(DEMUX_COMPLETION_BARRIER)
