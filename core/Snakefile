        print(f"Published sealed delivery: {marker.parent}", flush=True)


rule initial_cell_manifest:
    """合并项目 manifest 与孔板 map 或逐文库 called cells，生成初始 cell manifest。"""
    input:
        project_manifest = SAMPLE_MANIFEST,
        barcode_map = [BARCODE_MAP] if BARCODE_MAP is not None else [],
        called = expand(str(INTERMEDIATE_DIR / "demux/calling/{sample}/called_cells.csv"), sample=DEMUX_RUN_IDS) if PROTOCOL_POLICY.name == "droplet" else []
    output:
        manifest = INTERMEDIATE_DIR / "sample_manifest.tsv"
    log:
        LOGS_DIR / "rules/initial_cell_manifest.log"
    conda: ENVIRONMENT_YAML
    resources:
        mem_mb = lambda wildcards, attempt: controller_resource_mem_mb(
            "initial_cell_manifest", attempt
        ),
        runtime = lambda wildcards, attempt: controller_resource_runtime_min(
            "initial_cell_manifest", attempt
        )
    params:
        species = SPECIES,
        protocol = PROTOCOL_POLICY.name,
        barcode_map = shlex.quote(str(BARCODE_MAP) if BARCODE_MAP is not None else ""),
        called_args = " ".join("--called-cells=" + shlex.quote(RAW_SAMPLES_MAP[run]["sample_id"] + ":" + str(INTERMEDIATE_DIR / "demux/calling" / run / "called_cells.csv")) for run in DEMUX_RUN_IDS) if PROTOCOL_POLICY.name == "droplet" else ""
    shell:
        r"""
        set -euo pipefail
        export PYTHONPATH="$DNA_PIPELINE_ROOT/core"
        mkdir -p "$(dirname {output.manifest:q})" "$(dirname {log:q})"
        python -m dna_pipeline write-cell-manifest \
            {input.project_manifest:q} \
            {params.barcode_map} \
            {output.manifest:q} \
            --species {params.species:q} \
            --protocol {params.protocol:q} {params.called_args} > {log:q} 2>&1
        """
if PROTOCOL_POLICY.name == "droplet":
    rule droplet_call_cells:
        """按原始文库统计完整结构并调用细胞，失败时保留谷底诊断。"""
        input:
            r1 = lambda wc: RAW_SAMPLES_MAP[wc.sample]["r1"],
            binary = str(DEMUX_BINARY)
        output:
            counts = INTERMEDIATE_DIR / "demux/calling/{sample}/counts.tsv",
            structure = INTERMEDIATE_DIR / "demux/calling/{sample}/structure.json",
            metrics = INTERMEDIATE_DIR / "demux/calling/{sample}/calling.json",
            cells = INTERMEDIATE_DIR / "demux/calling/{sample}/called_cells.csv"
        params:
            calling_identity = DROPLET_CALLING_IDENTITY,
            r1_args = lambda wc: repeated_cli_flag("--r1", RAW_SAMPLES_MAP[wc.sample]["r1"])
        log:
            LOGS_DIR / "rules/droplet_calling/{sample}.log"
        threads: DEMUX_THREADS
        resources:
            mem_mb = lambda wc, attempt: demux_resource_mem_mb(wc.sample, attempt, count_only=True),
            runtime = lambda wc, attempt: demux_resource_runtime_min(wc.sample, attempt, count_only=True)
        conda: ENVIRONMENT_YAML
        shell:
            r"""
            set -euo pipefail
            export PYTHONPATH="$DNA_PIPELINE_ROOT/core"
            mkdir -p "$(dirname {output.cells:q})" "$(dirname {log:q})"
            {input.binary:q} --mode dna-only-droplet --count-only \
                {params.r1_args} --threads {threads} \
                --counts-output {output.counts:q} --count-metrics {output.structure:q} > {log:q} 2>&1
            if ! python -m dna_pipeline call-droplet-cells --counts {output.counts:q} \
                --output {output.cells:q} --metrics {output.metrics:q} \
                {params.r1_args} --demux-binary {input.binary:q} --threads {threads} >> {log:q} 2>&1; then
                cat {output.metrics:q} >> {log:q}
                exit 1
            fi
            cat {output.structure:q} {output.metrics:q} >> {log:q}
            """


checkpoint demux:
    """按 raw run 原子提交解复用 FASTQ、manifest、报告与 completion 边界。"""
    input:
        r1 = lambda wc: RAW_SAMPLES_MAP[wc.sample]["r1"],
        r2 = lambda wc: RAW_SAMPLES_MAP[wc.sample]["r2"],
        barcode_map = lambda wc: str(INTERMEDIATE_DIR / "demux/calling" / wc.sample / "called_cells.csv") if PROTOCOL_POLICY.name == "droplet" else str(BARCODE_MAP),
        calling = lambda wc: [str(INTERMEDIATE_DIR / "demux/calling" / wc.sample / "calling.json"), str(INTERMEDIATE_DIR / "demux/calling" / wc.sample / "structure.json")] if PROTOCOL_POLICY.name == "droplet" else [],
        cell_manifest = rules.initial_cell_manifest.output.manifest,
        binary = str(DEMUX_BINARY),
    output:
        completion = update(DEMUX_COMPLETION_PATTERN),
        json_report = update(DEMUX_STATE_DIR / "{sample}" / "report.json"),
        json_mqc = update(DEMUX_STATE_DIR / "{sample}" / "demux_mqc.json"),
        manifest = update(DEMUX_STATE_DIR / "{sample}" / "manifest.tsv"),
    params:
        sample_name = lambda wc: RAW_SAMPLES_MAP[wc.sample]["sample_id"],
        raw_sample = lambda wc: RAW_SAMPLES_MAP[wc.sample]["raw_sample"],
        r1_args = lambda wc: repeated_cli_flag("--r1", RAW_SAMPLES_MAP[wc.sample]["r1"]),
        r2_args = lambda wc: repeated_cli_flag("--r2", RAW_SAMPLES_MAP[wc.sample]["r2"]),
        input_fastq_pairs = lambda wc: len(RAW_SAMPLES_MAP[wc.sample]["r1"]),
        min_matched_read_pairs = DEMUX_MIN_MATCHED_READ_PAIRS,
        dna_w_spacer_len = DNA_W_SPACER_LEN,
        demux_mode = lambda wc: DEMUX_RUN_ROUTES[wc.sample].demux_mode,
        pipeline_mode = PROTOCOL_POLICY.name,
        calling_identity = DROPLET_CALLING_IDENTITY,
        calling_args = lambda wc: "--calling-metrics " + shlex.quote(str(INTERMEDIATE_DIR / "demux/calling" / wc.sample / "calling.json")) + " --structure-metrics " + shlex.quote(str(INTERMEDIATE_DIR / "demux/calling" / wc.sample / "structure.json")) if PROTOCOL_POLICY.name == "droplet" else "",
        route_id = lambda wc: DEMUX_RUN_ROUTES[wc.sample].route_id,
        downstream_dna = lambda wc: DEMUX_RUN_ROUTES[wc.sample].downstream_dna,
        dna_dir = lambda wc: str(DNA_OUT_DIR / wc.sample),
        rna_dir = lambda wc: str(RNA_OUT_DIR / wc.sample),
        resource_log = lambda wc: demux_resource_log(wc.sample)
    threads: DEMUX_THREADS
    resources:
        mem_mb = lambda wildcards, attempt: demux_resource_mem_mb(
            wildcards.sample, attempt
        ),
        runtime = lambda wildcards, attempt: demux_resource_runtime_min(
            wildcards.sample, attempt
        ),
        attempt_no = lambda wildcards, attempt: int(attempt)
    conda: ENVIRONMENT_YAML
    log:
        LOGS_DIR / "rules/demux/{sample}.log"
    shell:
        r"""
        set -euo pipefail
        source {JOB_RUNTIME:q}
        export PYTHONPATH="$DNA_PIPELINE_ROOT/core"
        mkdir -p \
            "$(dirname {output.json_report:q})" \
            "$(dirname {output.json_mqc:q})" \
            "$(dirname {output.manifest:q})" \
            "$(dirname {output.completion:q})" \
            "$(dirname {params.dna_dir:q})" \
            "$(dirname {params.rna_dir:q})" \
            "$(dirname {log:q})"
        dna_pipeline_init_attempt_logs {resources.attempt_no} {log:q}
        printf '%s attempt=%s threads=%s mem_mb=%s runtime_min=%s\n' \
            {params.resource_log:q} {resources.attempt_no} {threads} \
            {resources.mem_mb} {resources.runtime} >> {log:q}

        demux_tool={input.binary:q}
        [ -x "$demux_tool" ] || {{
            printf 'ERROR: demux_rs is missing or not executable: %s\n' "$demux_tool" >&2
            exit 127
        }}
        {{
            echo "protocol={params.pipeline_mode}"
            echo "demux_mode={params.demux_mode}"
            echo "route_id={params.route_id}"
            echo "downstream_dna={params.downstream_dna}"
            echo "min_matched_read_pairs={params.min_matched_read_pairs}"
            echo "input_fastq_pairs={params.input_fastq_pairs}"
            echo "allocated_cpus={threads}"
            echo "worker_threads=$(({threads} > 2 ? {threads} - 2 : 1))"
            "$demux_tool" --build-info
        }} >> {log:q} 2>&1

        dna_final={params.dna_dir:q}
        rna_final={params.rna_dir:q}
        dna_tmp="${{dna_final}}.tmp.$$"
        rna_tmp="${{rna_final}}.tmp.$$"
        report_tmp={output.json_report:q}.tmp.$$
        mqc_tmp={output.json_mqc:q}.tmp.$$
        manifest_tmp={output.manifest:q}.tmp.$$
        completion_final={output.completion:q}
        completion_tmp={output.completion:q}.tmp.$$
        backup_suffix=".backup"
        publish_in_progress=0

        restore_demux_path() {{
            target="$1"
            backup="${{target}}${{backup_suffix}}"
            absent="${{backup}}.absent"
            if [[ -e "$backup" || -L "$backup" ]]; then
                rm -rf -- "$target"
                mv "$backup" "$target"
            elif [[ -e "$absent" ]]; then
                rm -rf -- "$target"
                rm -f -- "$absent"
            fi
        }}

        rollback_demux_publish() {{
            restore_demux_path "$dna_final"
            restore_demux_path "$rna_final"
            restore_demux_path {output.json_report:q}
            restore_demux_path {output.json_mqc:q}
            restore_demux_path {output.manifest:q}
            restore_demux_path "$completion_final"
        }}

        discard_demux_backup() {{
            target="$1"
            rm -rf -- "${{target}}${{backup_suffix}}"
            rm -f -- "${{target}}${{backup_suffix}}.absent"
        }}

        if [[ -e "${{completion_final}}${{backup_suffix}}" || \
              -e "${{completion_final}}${{backup_suffix}}.absent" ]]; then
            if [[ -e "$completion_final" ]]; then
                discard_demux_backup "$dna_final"
                discard_demux_backup "$rna_final"
                discard_demux_backup {output.json_report:q}
                discard_demux_backup {output.json_mqc:q}
                discard_demux_backup {output.manifest:q}
                discard_demux_backup "$completion_final"
            else
                rollback_demux_publish
            fi
        fi

        cleanup_demux_tmp() {{
            exit_status=$?
            if (( publish_in_progress == 1 )); then
                rollback_demux_publish || true
            fi
            rm -rf -- "$dna_tmp" "$rna_tmp"
            rm -f -- "$report_tmp" "$mqc_tmp" "$manifest_tmp" "$completion_tmp"
            return "$exit_status"
        }}
        trap cleanup_demux_tmp EXIT

        rm -rf -- "$dna_tmp" "$rna_tmp"
        mkdir -p "$dna_tmp" "$rna_tmp"

        worker_threads=$(({threads} > 2 ? {threads} - 2 : 1))

        run_demux() {{
            "$demux_tool" \
              {params.r1_args} \
              {params.r2_args} \
              --barcode-map {input.barcode_map:q} \
              --dna-out-dir "$dna_tmp" \
              --rna-out-dir "$rna_tmp" \
              --json-report "$report_tmp" \
              --sample-name={params.sample_name:q} \
              --min-matched-read-pairs {params.min_matched_read_pairs} \
              --dna-w-spacer-len {params.dna_w_spacer_len} \
              --mode {params.demux_mode:q} \
              --threads "$worker_threads" \
              "$@"
        }}
        run_demux >> {log:q} 2>&1

        python -m dna_pipeline write-demux-metadata {params.calling_args} -- \
            "$report_tmp" "$mqc_tmp" "$manifest_tmp" "$dna_final" "$rna_final" \
            {params.pipeline_mode:q} {params.route_id:q} {params.downstream_dna:q} \
            {params.raw_sample:q} {input.cell_manifest:q} >> {log:q} 2>&1

        backup_demux_path() {{
            target="$1"
            backup="${{target}}${{backup_suffix}}"
            absent="${{backup}}.absent"
            rm -rf -- "$backup"
            rm -f -- "$absent"
            if [[ -e "$target" || -L "$target" ]]; then
                mv "$target" "$backup"
            else
                : > "$absent"
            fi
        }}

        publish_in_progress=1
        backup_demux_path "$completion_final"
        backup_demux_path "$dna_final"
        backup_demux_path "$rna_final"
        backup_demux_path {output.json_report:q}
        backup_demux_path {output.json_mqc:q}
        backup_demux_path {output.manifest:q}

        mv "$dna_tmp" "$dna_final"
        mv "$rna_tmp" "$rna_final"
        mv "$report_tmp" {output.json_report:q}
        mv "$mqc_tmp" {output.json_mqc:q}
        mv "$manifest_tmp" {output.manifest:q}

        python -m dna_pipeline write-demux-completion \
            "$completion_tmp" \
            --run-id={wildcards.sample:q} \
            --project-sample-id={params.sample_name:q} \
            --manifest {output.manifest:q} \
            --report {output.json_report:q} \
            --mqc {output.json_mqc:q} \
            --dna-dir "$dna_final" \
            --rna-dir "$rna_final" \
            --cell-manifest {input.cell_manifest:q} >> {log:q} 2>&1
        mv "$completion_tmp" "$completion_final"


        publish_in_progress=0
        discard_demux_backup "$dna_final"
        discard_demux_backup "$rna_final"
        discard_demux_backup {output.json_report:q}
        discard_demux_backup {output.json_mqc:q}
        discard_demux_backup {output.manifest:q}
        discard_demux_backup "$completion_final"
        trap - EXIT
        """


