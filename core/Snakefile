def repeated_cli_flag(flag, values):
    return " ".join(f"{flag} {shlex.quote(str(value))}" for value in values)

@functools.lru_cache(maxsize=1)
def current_demux_manifest_index():
    for run_id in DEMUX_RUN_IDS:
        checkpoints.demux.get(sample=run_id)
    return demux_manifest_index(DEMUX_STATE_DIR, tuple(DEMUX_RUN_IDS))

def current_demux_fastq(demux_sample, read_pair):
    return ancient(resolve_demux_fastq_from_manifest(
        INTERMEDIATE_DIR,
        demux_sample,
        read_pair,
        manifest_index=current_demux_manifest_index(),
    ))

def current_demux_source_inputs(wildcards):
    manifest, _row = current_demux_match(wildcards.demux_sample)
    raw = RAW_SAMPLES_MAP[manifest.parent.name]
    return [*raw["r1"], *raw["r2"], SAMPLE_MANIFEST, *([] if BARCODE_MAP is None else [BARCODE_MAP]), str(DEMUX_BINARY)]

@functools.lru_cache(maxsize=None)
def current_demux_match(demux_sample):
    if demux_sample is None:
        return None
    sample = Path(str(demux_sample)).name.strip()
    if not sample:
        return None
    matches = [
        (manifest, row)
        for manifest, row in current_demux_manifest_index().get(sample, [])
        if str(row.get("downstream_dna", "") or "").strip().lower() == "true"
    ]
    if len(matches) > 1:
        locations = ", ".join(str(manifest) for manifest, _row in matches)
        raise ValueError(
            f"Cell {sample!r} occurs in more than one downstream-DNA demux manifest: {locations}"
        )
    if not matches:
        return None
    return matches[0]

def current_demux_row(demux_sample):
    match = current_demux_match(demux_sample)
    return None if match is None else match[1]

def current_demux_completion(wildcards):
    sample = Path(str(wildcards.demux_sample)).name.strip()
    match = current_demux_match(sample)
    if match is None:
        raise FileNotFoundError(
            f"No committed downstream-DNA demux row for {sample!r}"
        )
    manifest, _row = match
    if manifest.parent.parent != DEMUX_STATE_DIR:
        raise ValueError(f"Unexpected demux manifest path: {manifest}")
    run_id = manifest.parent.name
    checkpoint_output = checkpoints.demux.get(sample=run_id).output
    if Path(str(checkpoint_output.manifest)).resolve() != manifest.resolve():
        raise ValueError(
            f"Checkpoint {run_id!r} returned the wrong manifest: "
            f"{checkpoint_output.manifest} != {manifest}"
        )
    return ancient(str(checkpoint_output.completion))

def current_run_demux_manifest(wildcards):
    checkpoint_job = checkpoints.demux.get(sample=wildcards.sample)
    return str(checkpoint_job.output.manifest)


def demux_sample_dna_reads(demux_sample):
    row = current_demux_row(demux_sample)
    if row is None:
        return None
    raw_value = str(row.get("dna_reads", "") or "").strip()
    try:
        dna_reads = int(raw_value)
    except (TypeError, ValueError):
        return None
    return dna_reads if dna_reads >= 0 else None

def dupsifter_metadata_json(demux_sample):
    row = current_demux_row(demux_sample)
    if row is None:
        raise FileNotFoundError(
            f"No committed downstream-DNA demux row for {demux_sample!r}"
        )
    fields = (
        "demux_sample", "raw_sample", "pipeline_mode", "route_id",
        "plate_id", "cell_order", "dna_barcode", "downstream_dna", "dna_status",
    )
    return json.dumps(
        {field: str(row.get(field, "") or "") for field in fields},
        ensure_ascii=True,
        sort_keys=True,
        separators=(",", ":"),
    )

def static_resource_request(rule_key, demux_sample=None, attempt=1):
    return resource_request(
        rule_key,
        dna_reads=demux_sample_dna_reads(demux_sample),
        attempt=int(attempt),
    )

def static_resource_mem_mb(rule_key, demux_sample=None, attempt=1):
    return int(static_resource_request(rule_key, demux_sample, attempt).mem_mb)

def static_resource_runtime_min(rule_key, demux_sample=None, attempt=1):
    return int(static_resource_request(rule_key, demux_sample, attempt).runtime_min)

@functools.lru_cache(maxsize=None)
def demux_run_total_bytes(run_id, mates=("r1", "r2")):
    """统计 run 指定 mate 的压缩 FASTQ 字节；identity 缺 size_bytes 时回退 stat 实际路径。"""
    if not RUN_SNAPSHOT:
        return None
    basis = RUN_SNAPSHOT.get("basis")
    records = basis.get("raw_fastqs") if isinstance(basis, Mapping) else None
    if not isinstance(records, list):
        return None
    target = str(run_id).strip()
    total = 0
    for record in records:
        if str(record.get("raw_sample", "")) != target:
            continue
        for mate in mates:
            identity = record.get(mate)
            if not isinstance(identity, Mapping):
                continue
            size_bytes = int(identity.get("size_bytes", 0) or 0)
            if size_bytes <= 0:
                path = str(identity.get("path", "") or "")
                try:
                    size_bytes = os.path.getsize(path) if path else 0
                except OSError:
                    size_bytes = 0
            total += size_bytes
    return total

def demux_resource_mem_mb(run_id, attempt=1, count_only=False):
    request = demux_resource_request(
        demux_run_total_bytes(run_id, mates=("r1",) if count_only else ("r1", "r2")),
        int(attempt), count_only=count_only,
    )
    return int(request.mem_mb)

def demux_resource_runtime_min(run_id, attempt=1, count_only=False):
    request = demux_resource_request(
        demux_run_total_bytes(run_id, mates=("r1",) if count_only else ("r1", "r2")),
        int(attempt), count_only=count_only,
    )
    return int(request.runtime_min)

def demux_resource_log(run_id):
    request = demux_resource_request(demux_run_total_bytes(run_id), 1)
    total = demux_run_total_bytes(run_id)
    return (
        f"policy={request.policy} rule=demux run={run_id} "
        f"input_bytes={'NA' if total is None else total} tier={request.tier}"
    )

def combined_static_runtime_min(rule_keys, demux_sample=None, attempt=1):
    return int(
        combined_runtime_min(
            tuple(rule_keys), demux_sample_dna_reads(demux_sample), int(attempt)
        )
    )

def controller_resource_mem_mb(rule_key, attempt=1):
    return int(controller_resource_request(rule_key, int(attempt)).mem_mb)

def controller_resource_runtime_min(rule_key, attempt=1):
    return int(controller_resource_request(rule_key, int(attempt)).runtime_min)

def static_resource_log(rule_key, demux_sample=None):
    request = static_resource_request(rule_key, demux_sample, 1)
    cell = Path(str(demux_sample)).name.strip() if demux_sample is not None else "NA"
    cell = cell or "NA"
    dna_reads = "NA" if request.dna_reads is None else str(request.dna_reads)
    return (
        f"policy={request.policy} rule={request.rule_key} cell={cell} "
        f"dna_reads={dna_reads} tier={request.tier}"
    )

def static_scratch_mb(scratch_group, demux_sample=None):
    return int(
        scratch_mb(
            str(scratch_group), demux_sample_dna_reads(demux_sample)
        )
    )

def backend_stage_request(backend, stage, demux_sample=None, attempt=1):
    return backend_resource_request(
        backend,
        stage,
        demux_sample_dna_reads(demux_sample),
        attempt=int(attempt),
        executor=PIPELINE_EXECUTOR,
        local_cores=LOCAL_EXECUTOR_CORES,
        bismark_local_alignment=(
            BISMARK_LOCAL_ALIGNMENT
            if str(backend) == "bismark" and str(stage) == "align"
            else False
        ),
    )

def backend_stage_resource_log(backend, stage, demux_sample=None):
    request = backend_stage_request(backend, stage, demux_sample, 1)
    return static_resource_log(request.rule_key, demux_sample)

def backend_stage_threads(backend, stage, wildcards):
    return int(
        backend_stage_request(backend, stage, wildcards.demux_sample, 1).threads
    )

def backend_stage_mem_mb(backend, stage, demux_sample=None, attempt=1):
    return int(backend_stage_request(backend, stage, demux_sample, attempt).mem_mb)

def backend_stage_runtime_min(backend, stage, demux_sample=None, attempt=1):
    return int(
        backend_stage_request(backend, stage, demux_sample, attempt).runtime_min
    )

def backend_preprocess_runtime_min(backend, demux_sample=None, attempt=1):
    return int(
        static_resource_runtime_min("cutadapt", demux_sample, attempt)
        + backend_stage_runtime_min(backend, "align", demux_sample, attempt)
    )

DEMUX_THREADS = resource_threads("demux")
CUTADAPT_THREADS = resource_threads("cutadapt")
ALIGN_THREADS = lambda wildcards: backend_stage_threads("biscuit", "align", wildcards)
BISMARK_ALIGN_THREADS = lambda wildcards: backend_stage_threads("bismark", "align", wildcards)
HIGH_CPH_READ_NAMES_THREADS = resource_threads("high_cph_read_names")
BSCONV_DNA_THREADS = resource_threads("bsconv_dna")
HIGH_CPH_BAM_THREADS = resource_threads("high_cph_bam")
PILEUP_THREADS = resource_threads("pileup")
CPG_THREADS = resource_threads("generate_cpg_input")
BISMARK_EXTRACT_THREADS = lambda wildcards: backend_stage_threads("bismark", "extract", wildcards)
SNP_THREADS = resource_threads("generate_snp_input")
BISCUIT_QC_THREADS = resource_threads("biscuit_qc")
MULTIQC_THREADS = resource_threads("multiqc")
HIGH_CPH_FILTER_RULES = STATIC_FUSED_RULES["high_cph_filter"]

def passing_dna_rows(checkpoints_obj, run_id, workflow_config):
    policy = get_protocol_policy(workflow_config)
    checkpoint_job = checkpoints_obj.demux.get(sample=run_id)
    chk_output = checkpoint_job.output
    expected_manifest = (DEMUX_STATE_DIR / run_id / "manifest.tsv").resolve()
    if Path(chk_output.manifest).resolve() != expected_manifest:
        raise ValueError(
            f"Demux checkpoint {run_id!r} returned an unexpected manifest: "
            f"{chk_output.manifest} != {expected_manifest}"
        )
    index = current_demux_manifest_index()
    rows = [
        row
        for entries in index.values()
        for _manifest, row in entries
        if _manifest.resolve() == expected_manifest
    ]
    passing = []
    for row in rows:
        demux_sample = row.get("demux_sample", "")
        manifest_protocol = (row.get("pipeline_mode") or "").strip().lower()
        manifest_route = (row.get("route_id") or "").strip().lower()
        manifest_demux_mode = (row.get("demux_mode") or "").strip().lower()
        manifest_rna_role = (row.get("rna_output_role") or "").strip().lower()
        manifest_high_cph_role = (row.get("high_cph_role") or "").strip().lower()
        manifest_downstream = (row.get("downstream_dna") or "").strip().lower()
        try:
            route = get_raw_route(manifest_route, policy.name)
        except Exception as exc:
            raise ValueError(
                f"Demux manifest contains an invalid route {manifest_route!r}: {expected_manifest}"
            ) from exc
        if (
            manifest_protocol != policy.name
            or manifest_demux_mode != route.demux_mode
            or manifest_rna_role != route.rna_output_role
            or manifest_high_cph_role != route.high_cph_role
            or manifest_downstream != ("true" if route.downstream_dna else "false")
        ):
            raise ValueError(
                "Demux manifest was produced under a different protocol/raw-route policy: "
                f"manifest={expected_manifest}, protocol={manifest_protocol!r}, route={manifest_route!r}, "
                f"demux_mode={manifest_demux_mode!r}, downstream_dna={manifest_downstream!r}; "
                f"current policy={policy.name!r}/{route.route_id!r}/{route.demux_mode!r}/"
                f"downstream_dna={route.downstream_dna}. Remove this run's demux outputs and rerun."
            )
        if not route.downstream_dna or row.get("dna_status") != "Pass":
            continue
        if not str(demux_sample or "").strip():
            raise ValueError(
                f"Demux manifest marks a DNA library as Pass without a sample id: {expected_manifest}"
            )
        passing.append(row)
    return passing

@functools.lru_cache(maxsize=1)
def _cached_demuxed_samples(run_ids_key):
    samples = []
    for run_id in run_ids_key:
        samples.extend(
            row["demux_sample"]
            for row in passing_dna_rows(checkpoints, run_id, config)
        )
    seen, duplicates = set(), set()
    for sample in samples:
        if sample in seen:
            duplicates.add(sample)
        seen.add(sample)
    if duplicates:
        raise ValueError(
            "Canonical DNA cell(s) appear in more than one committed demux run: "
            + ", ".join(sorted(duplicates))
        )
    return tuple(samples)

def get_demuxed_samples():
    return list(_cached_demuxed_samples(tuple(DEMUX_RUN_IDS)))

def get_staged_delivery_targets():
    samples = get_demuxed_samples()
    biscuit = config["biscuit"]
    backend = get_backend(config)
    layout = ProjectLayout(INTERMEDIATE_DIR, STAGED_RESULTS_DIR, backend.name)
    targets = [str(layout.cell(sample).cpg) for sample in samples]
    if biscuit["generate_snp"]:
        if not backend.supports_snp:
            raise ValueError("generate_snp=true is currently supported only by the Biscuit backend")
        for sample in samples:
            paths = layout.cell(sample)
            targets.extend([str(paths.snp), str(paths.snp_index)])
    return targets
