                --run-id={wildcards.sample:q} > {log:q} 2>&1
            """
if METHYLATION_BACKEND == "biscuit":
    rule align_sort_dedup:
        """在单个节点 scratch 作业内完成一个细胞的 Cutadapt trimming、BISCUIT 比对、Dupsifter 去重与坐标排序。"""
        input:
            r1 = lambda wc: current_demux_fastq(wc.demux_sample, 1),
            r2 = lambda wc: current_demux_fastq(wc.demux_sample, 2),
            demux_sources = current_demux_source_inputs,
            ref = REFERENCE_GENOME,
            ref_fai = str(REFERENCE_FAI),
            ref_indexes = REFERENCE_BISCUIT_INDEXES,
            ref_alt = REFERENCE_ALT_DEP
        output:
            report = CELL_PATH_PATTERN.cutadapt_json,
            bam = temp(CELL_PATH_PATTERN.post_alignment_bam),
            bai = temp(CELL_PATH_PATTERN.post_alignment_bam_index),
            mqc = CELL_PATH_PATTERN.dupsifter_multiqc
        log:
            main = LOGS_DIR / "rules/biscuit/{demux_sample}_align.log",
            cutadapt = LOGS_DIR / "rules/cutadapt/{demux_sample}.log",
            biscuit = LOGS_DIR / "rules/biscuit/{demux_sample}_biscuit.log",
            dupsifter = LOGS_DIR / "rules/biscuit/{demux_sample}_dupsifter.log",
            sort = LOGS_DIR / "rules/biscuit/{demux_sample}_sort.log"
        threads: ALIGN_THREADS
        resources:
            mem_mb = lambda wildcards, attempt: backend_stage_mem_mb(
                "biscuit", "align", wildcards.demux_sample, attempt
            ),
            runtime = lambda wildcards, attempt: backend_preprocess_runtime_min(
                "biscuit", wildcards.demux_sample, attempt
            ),
            disk_mb = lambda wildcards: static_scratch_mb(
                "preprocess_alignment", wildcards.demux_sample
            ),
            attempt_no = lambda wildcards, attempt: int(attempt)
        params:
            demux_spacer_len = DNA_W_SPACER_LEN,
            calling_identity = DROPLET_CALLING_IDENTITY,
            demux_mode = lambda wc: DEMUX_RUN_ROUTES[current_demux_match(wc.demux_sample)[0].parent.name].demux_mode,
            rg_header = lambda wc: "@RG\\tID:{0}\\tSM:{0}\\tPL:ILLUMINA".format(
                wc.demux_sample.replace(os.sep, "_")
            ),
            cutadapt = CUTADAPT,
            cutadapt_threads = CUTADAPT_THREADS,
            cutadapt_quality = CUTADAPT_QUALITY_CUTOFF,
            cutadapt_min_length = CUTADAPT_MIN_LENGTH,
            adapter_r1_spec = lambda wc: CUTADAPT_ADAPTER_R1_SPEC,
            adapter_r2_spec = lambda wc: CUTADAPT_ADAPTER_R2_SPEC,
            biscuit = BISCUIT,
            dupsifter_metadata = lambda wc: dupsifter_metadata_json(wc.demux_sample),
            samtools = SAMTOOLS,
            local_tmp = NODE_TMPDIR,
            scratch_namespace = SCRATCH_NAMESPACE,
            biscuit_library_mode = BISCUIT_LIBRARY_MODE,
            dupsifter_extra = "--remove-dups",
            resource_log = lambda wc: static_resource_log("align_sort_dedup", wc.demux_sample)
        conda: ENVIRONMENT_YAML
        shell:
            r"""
            set -euo pipefail
            source {JOB_RUNTIME:q}
            export PYTHONPATH="$DNA_PIPELINE_ROOT/core"
            ulimit -s unlimited 2>/dev/null || true

            mkdir -p \
                "$(dirname {output.report:q})" \
                "$(dirname {output.bam:q})" \
                "$(dirname {log.main:q})" \
                "$(dirname {log.cutadapt:q})"

            dna_pipeline_init_attempt_logs {resources.attempt_no} \
                {log.main:q} {log.cutadapt:q} {log.biscuit:q} \
                {log.dupsifter:q} {log.sort:q}
            printf '%s attempt=%s threads=%s mem_mb=%s runtime_min=%s scratch_mb=%s\n' \
                {params.resource_log:q} {resources.attempt_no} {threads} \
                {resources.mem_mb} {resources.runtime} {resources.disk_mb} >> {log.main:q}
            printf 'stage=cutadapt attempt=%s threads=%s merged_runtime_min=%s\n' \
                {resources.attempt_no} {params.cutadapt_threads} {resources.runtime} >> {log.cutadapt:q}

            exec 2>> {log.main:q}

            dna_pipeline_allocate_scratch \
                {params.local_tmp:q} {params.scratch_namespace:q} \
                preprocess_alignment \
                {wildcards.demux_sample:q} {resources.disk_mb} {PROJECT_DIR:q}
            dna_pipeline_install_scratch_cleanup
            tmpdir="$DNA_PIPELINE_SCRATCH_DIR"

            tmp_r1="$tmpdir/trim.1.fastq.gz"
            tmp_r2="$tmpdir/trim.2.fastq.gz"
            tmp_report="$tmpdir/cutadapt.json"
            tmp_unsorted="$tmpdir/dedup.unsorted.bam"
            tmp_bam="$tmpdir/output.bam"
            tmp_stat="$tmpdir/dupsifter.stat"
            tmp_mqc="$tmpdir/dupsifter_mqc.json"

            echo "INFO: sample={wildcards.demux_sample}" >&2
            dna_pipeline_log_scratch >&2

            echo "INFO: stage=cutadapt status=START" >&2
            dna_pipeline_run_cutadapt \
                {params.cutadapt:q} {GZIP:q} {params.cutadapt_threads} \
                {params.cutadapt_quality:q} {params.cutadapt_min_length} \
                {params.adapter_r1_spec:q} {params.adapter_r2_spec:q} \
                {input.r1:q} {input.r2:q} "$tmp_r1" "$tmp_r2" "$tmp_report" {log.cutadapt:q}
            echo "INFO: stage=cutadapt status=OK" >&2

            biscuit_threads=$(({threads} - 1))
            (( biscuit_threads > 15 )) && biscuit_threads=15
            (( biscuit_threads >= 1 )) || biscuit_threads=1
            echo "INFO: stage=align_dedup status=START biscuit_threads=$biscuit_threads" >&2
            set +e
            {params.biscuit:q} align \
                -@ "$biscuit_threads" \
                -b {params.biscuit_library_mode} \
                -R {params.rg_header:q} \
                {input.ref:q} "$tmp_r1" "$tmp_r2" \
                2>> {log.biscuit:q} | \
            {DUPSIFTER_BINARY:q} {params.dupsifter_extra} \
                -O "$tmp_stat" \
                -o "$tmp_unsorted" \
                {input.ref:q} \
                2>> {log.dupsifter:q}
            stage_status=("${{PIPESTATUS[@]}}")
            set -e
            biscuit_status=${{stage_status[0]:-99}}
            dupsifter_status=${{stage_status[1]:-99}}
            if (( biscuit_status != 0 || dupsifter_status != 0 )); then
                echo "ERROR: stage=align_dedup biscuit_exit=$biscuit_status dupsifter_exit=$dupsifter_status" >&2
                tail -n 80 {log.biscuit:q} >&2 || true
                tail -n 80 {log.dupsifter:q} >&2 || true
                exit 1
            fi

            [[ -s "$tmp_unsorted" ]] || {{ echo "ERROR: dupsifter produced an empty BAM" >&2; exit 1; }}
            [[ -s "$tmp_stat" ]] || {{ echo "ERROR: dupsifter produced no statistics" >&2; exit 1; }}
            {params.samtools:q} quickcheck -v "$tmp_unsorted" >> {log.main:q} 2>&1
            rm -f -- "$tmp_r1" "$tmp_r2"

            sort_extra_threads=$(({threads} - 1))
            (( sort_extra_threads > 15 )) && sort_extra_threads=15
            (( sort_extra_threads >= 1 )) || sort_extra_threads=1
            echo "INFO: stage=samtools_sort status=START extra_threads=$sort_extra_threads mem_per_thread=768M" >&2
            set +e
            {params.samtools:q} sort \
                -@ "$sort_extra_threads" \
                -m 768M \
                -T "$tmpdir/sort" \
                -O BAM \
                -o "$tmp_bam" \
                "$tmp_unsorted" \
                2>> {log.sort:q}
            sort_status=$?
            set -e
            if (( sort_status != 0 )); then
                (( sort_status != 137 )) || echo "ERROR: component=SAMTOOLS_SORT reason=SIGKILL_or_OOM" >&2
                tail -n 100 {log.sort:q} >&2 || true
                exit 1
            fi
            rm -f -- "$tmp_unsorted"
            {params.samtools:q} quickcheck -v "$tmp_bam" >> {log.main:q} 2>&1
            {params.samtools:q} index -@ "$sort_extra_threads" "$tmp_bam" >> {log.sort:q} 2>&1

            python -m dna_pipeline write-dupsifter-qc \
                "$tmp_stat" "$tmp_mqc" \
                --sample={wildcards.demux_sample:q} \
                --metadata {params.dupsifter_metadata:q} >> {log.main:q} 2>&1

            echo "INFO: stage=publish status=START" >&2
            python -m dna_pipeline atomic-publish \
                --samtools {params.samtools:q} \
                --bam-destination {output.bam:q} \
                --commit-last {output.bam:q} \
                --file "$tmp_report" {output.report:q} \
                --file "$tmp_bam.bai" {output.bai:q} \
                --file "$tmp_mqc" {output.mqc:q} \
                --file "$tmp_bam" {output.bam:q} \
                >> {log.main:q} 2>&1


            echo "INFO: stage=publish status=OK" >&2
            dna_pipeline_release_scratch
            """
    MERGE_BSCONV_FILTER = not PUBLISH_RNA_BAM

    DNA_BAM_OUTPUT = temp(CELL_PATH_PATTERN.dna_bam) if not KEEP_FINAL_BAM else CELL_PATH_PATTERN.dna_bam
    DNA_BAI_OUTPUT = temp(CELL_PATH_PATTERN.dna_bam_index) if not KEEP_FINAL_BAM else CELL_PATH_PATTERN.dna_bam_index
    RNA_BAM_OUTPUT = CELL_PATH_PATTERN.rna_bam
    RNA_BAI_OUTPUT = CELL_PATH_PATTERN.rna_bam_index


    def get_pileup_bam(wildcards):
        return PROJECT_LAYOUT.cell(wildcards.demux_sample).dna_bam


    def get_pileup_bai(wildcards):
        return PROJECT_LAYOUT.cell(wildcards.demux_sample).dna_bam_index


    if MERGE_BSCONV_FILTER:
        rule bsconv_filter_dna:
            """在同一 scratch 作业内识别 high-CpH reads 并发布过滤后的 DNA BAM。"""
            input:
                demux_completion = current_demux_completion,
                bam = CELL_PATH_PATTERN.post_alignment_bam,
                bai = CELL_PATH_PATTERN.post_alignment_bam_index,
                ref = REFERENCE_GENOME,
                helper = str(BSCONV_MODULE_CODE),
            output:
                summary = CELL_PATH_PATTERN.high_cph_summary,
                mqc = temp(CELL_PATH_PATTERN.high_cph_multiqc),
                dna = DNA_BAM_OUTPUT,
                dna_bai = DNA_BAI_OUTPUT
            log:
                classify = LOGS_DIR / "rules/biscuit/{demux_sample}_high_cph_reads.log",
                filter = LOGS_DIR / "rules/biscuit/{demux_sample}_bsconv_dna.log"
            threads: BSCONV_DNA_THREADS
            resources:
                mem_mb = lambda wildcards, attempt: static_resource_mem_mb(
                    "high_cph_read_names", wildcards.demux_sample, attempt
                ),
                runtime = lambda wildcards, attempt: combined_static_runtime_min(
                    HIGH_CPH_FILTER_RULES, wildcards.demux_sample, attempt
                ),
                disk_mb = lambda wildcards: static_scratch_mb(
                    "high_cph_filter", wildcards.demux_sample
                ),
                attempt_no = lambda wildcards, attempt: int(attempt)
            params:
                biscuit = BISCUIT,
                samtools = SAMTOOLS,
                threshold = BISCUIT_HIGH_CPH_RETENTION_THRESHOLD,
                excluded_contigs_json = HIGH_CPH_EXCLUDED_CONTIGS_JSON,
                sample_name = lambda wc: wc.demux_sample.replace(os.sep, "_"),
                protocol = PROTOCOL_POLICY.name,
                high_cph_role = PROTOCOL_POLICY.high_cph_role,
                local_tmp = NODE_TMPDIR,
                scratch_namespace = SCRATCH_NAMESPACE,
                resource_log = lambda wc: static_resource_log(
                    "high_cph_read_names", wc.demux_sample
                )
            conda: ENVIRONMENT_YAML
            shell:
                r"""
                set -euo pipefail
                source {JOB_RUNTIME:q}
                mkdir -p "$(dirname {output.dna:q})" "$(dirname {log.classify:q})"
                dna_pipeline_init_attempt_logs {resources.attempt_no} \
                    {log.classify:q} {log.filter:q}
                printf '%s attempt=%s threads=%s mem_mb=%s runtime_min=%s scratch_mb=%s merged=bsconv_filter\n' \
                    {params.resource_log:q} {resources.attempt_no} {threads} \
                    {resources.mem_mb} {resources.runtime} {resources.disk_mb} >> {log.classify:q}
                printf '%s attempt=%s threads=%s mem_mb=%s runtime_min=%s scratch_mb=%s merged=bsconv_filter\n' \
                    {params.resource_log:q} {resources.attempt_no} {threads} \
                    {resources.mem_mb} {resources.runtime} {resources.disk_mb} >> {log.filter:q}

                dna_pipeline_allocate_scratch \
                    {params.local_tmp:q} {params.scratch_namespace:q} \
                    high_cph_filter \
                    {wildcards.demux_sample:q} {resources.disk_mb} {PROJECT_DIR:q}
                dna_pipeline_install_scratch_cleanup
                tmpdir="$DNA_PIPELINE_SCRATCH_DIR"

                tmp_names="$tmpdir/high_cph_reads.txt"
                tmp_summary="$tmpdir/bsconv_filter_summary.json"
                tmp_mqc="$tmpdir/bsconv_filter_mqc.json"
                tmp_bam="$tmpdir/dna.bam"

                dna_pipeline_log_scratch >> {log.filter:q} 2>&1

                common_extract_args=(
                    --bsconv-tsv -
                    --threshold {params.threshold}
                    --high-read-names "$tmp_names"
                    --summary-json "$tmp_summary"
                    --multiqc-json "$tmp_mqc"
                    --sample-name={params.sample_name:q}
                    --excluded-contigs-json {params.excluded_contigs_json:q}
                    --alignment-bam {input.bam:q}
                    --samtools {params.samtools:q}
                    --protocol {params.protocol:q}
                    --high-cph-role {params.high_cph_role:q}
                )

                dna_pipeline_run_bsconv_classification \
                    {params.samtools:q} {params.biscuit:q} {input.ref:q} {input.bam:q} \
                    {log.classify:q} "${{common_extract_args[@]}}"

                if [ ! -s "$tmp_names" ]; then
                    echo "INFO: no high-CpH reads detected; copying complete aligned BAM." >> {log.filter:q}
                    if cp --reflink=auto {input.bam:q} "$tmp_bam" 2>/dev/null; then
                        :
                    elif cp -c {input.bam:q} "$tmp_bam" 2>/dev/null; then
                        :
                    else
                        cp {input.bam:q} "$tmp_bam"
                    fi
                else
                    sam_extra=$(({threads} > 1 ? {threads} - 1 : 0))
                    {params.samtools:q} view -@ "$sam_extra" -b \
                        -N "^$tmp_names" \
                        -o "$tmp_bam" \
                        {input.bam:q} \
                        >> {log.filter:q} 2>&1
                fi
                {params.samtools:q} quickcheck -v "$tmp_bam" >> {log.filter:q} 2>&1
                {params.samtools:q} index "$tmp_bam" >> {log.filter:q} 2>&1

                python -m dna_pipeline atomic-publish \
                    --samtools {params.samtools:q} \
                    --bam-destination {output.dna:q} \
                    --commit-last {output.dna:q} \
                    --file "$tmp_summary" {output.summary:q} \
                    --file "$tmp_mqc" {output.mqc:q} \
                    --file "$tmp_bam.bai" {output.dna_bai:q} \
                    --file "$tmp_bam" {output.dna:q} \
                    >> {log.filter:q} 2>&1
                dna_pipeline_release_scratch
                """


    if not MERGE_BSCONV_FILTER:
        rule high_cph_read_names:
            """识别 high-CpH reads，写出 read names、守恒摘要与 MultiQC 输入。"""
            input:
                demux_completion = current_demux_completion,
                bam = CELL_PATH_PATTERN.post_alignment_bam,
                bai = CELL_PATH_PATTERN.post_alignment_bam_index,
                ref = REFERENCE_GENOME,
                helper = str(BSCONV_MODULE_CODE),
            output:
                names = temp(CELL_PATH_PATTERN.high_cph_read_names),
                summary = CELL_PATH_PATTERN.high_cph_summary,
                mqc = temp(CELL_PATH_PATTERN.high_cph_multiqc)
            log:
                LOGS_DIR / "rules/biscuit/{demux_sample}_high_cph_reads.log"
            threads: HIGH_CPH_READ_NAMES_THREADS
            resources:
                mem_mb = lambda wildcards, attempt: static_resource_mem_mb(
                    "high_cph_read_names", wildcards.demux_sample, attempt
                ),
                runtime = lambda wildcards, attempt: static_resource_runtime_min(
                    "high_cph_read_names", wildcards.demux_sample, attempt
                ),
                attempt_no = lambda wildcards, attempt: int(attempt)
            params:
                biscuit = BISCUIT,
                samtools = SAMTOOLS,
                threshold = BISCUIT_HIGH_CPH_RETENTION_THRESHOLD,
                excluded_contigs_json = HIGH_CPH_EXCLUDED_CONTIGS_JSON,
                sample_name = lambda wc: wc.demux_sample.replace(os.sep, "_"),
                protocol = PROTOCOL_POLICY.name,
                high_cph_role = PROTOCOL_POLICY.high_cph_role,
                resource_log = lambda wc: static_resource_log("high_cph_read_names", wc.demux_sample)
            conda: ENVIRONMENT_YAML
            shell:
                r"""
                set -euo pipefail
                source {JOB_RUNTIME:q}
                mkdir -p "$(dirname {output.names:q})" "$(dirname {log:q})"
                dna_pipeline_init_attempt_logs {resources.attempt_no} {log:q}
                printf '%s attempt=%s threads=%s mem_mb=%s runtime_min=%s\n' \
                    {params.resource_log:q} {resources.attempt_no} {threads} \
                    {resources.mem_mb} {resources.runtime} >> {log:q}

                tmp_names={output.names:q}.tmp.$$
                tmp_summary={output.summary:q}.tmp.$$
                tmp_mqc={output.mqc:q}.tmp.$$
                cleanup_bsconv_filter_tmp() {{
                    rm -f -- "$tmp_names" "$tmp_summary" "$tmp_mqc"
                }}
                trap cleanup_bsconv_filter_tmp EXIT

                common_extract_args=(
                    --bsconv-tsv -
                    --threshold {params.threshold}
                    --high-read-names "$tmp_names"
                    --summary-json "$tmp_summary"
                    --multiqc-json "$tmp_mqc"
                    --sample-name={params.sample_name:q}
                    --excluded-contigs-json {params.excluded_contigs_json:q}
                    --alignment-bam {input.bam:q}
                    --samtools {params.samtools:q}
                    --protocol {params.protocol:q}
                    --high-cph-role {params.high_cph_role:q}
                )

                dna_pipeline_run_bsconv_classification \
                    {params.samtools:q} {params.biscuit:q} {input.ref:q} {input.bam:q} \
                    {log:q} "${{common_extract_args[@]}}"


                mv "$tmp_names" {output.names:q}
                mv "$tmp_summary" {output.summary:q}
                mv "$tmp_mqc" {output.mqc:q}
                trap - EXIT
                """


    if not MERGE_BSCONV_FILTER:
        rule bsconv_dna:
            """按 high-CpH read names 过滤并原子发布 DNA BAM。"""
            input:
                demux_completion = current_demux_completion,
                bam = CELL_PATH_PATTERN.post_alignment_bam,
                bai = CELL_PATH_PATTERN.post_alignment_bam_index,
                high_names = rules.high_cph_read_names.output.names
            output:
                dna = DNA_BAM_OUTPUT,
                dna_bai = DNA_BAI_OUTPUT
            log:
                LOGS_DIR / "rules/biscuit/{demux_sample}_bsconv_dna.log"
            threads: BSCONV_DNA_THREADS
            resources:
                mem_mb = lambda wildcards, attempt: static_resource_mem_mb(
                    "bsconv_dna", wildcards.demux_sample, attempt
                ),
                runtime = lambda wildcards, attempt: static_resource_runtime_min(
                    "bsconv_dna", wildcards.demux_sample, attempt
                ),
                attempt_no = lambda wildcards, attempt: int(attempt)
            params:
                samtools = SAMTOOLS,
                resource_log = lambda wc: static_resource_log("bsconv_dna", wc.demux_sample)
            conda: ENVIRONMENT_YAML
            shell:
                r"""
                set -euo pipefail
                source {JOB_RUNTIME:q}
                mkdir -p "$(dirname {output.dna:q})" "$(dirname {log:q})"
                dna_pipeline_init_attempt_logs {resources.attempt_no} {log:q}
                printf '%s attempt=%s threads=%s mem_mb=%s runtime_min=%s\n' \
                    {params.resource_log:q} {resources.attempt_no} {threads} \
                    {resources.mem_mb} {resources.runtime} >> {log:q}

                tmp_bam={output.dna:q}.tmp.$$
                tmp_bai="$tmp_bam.bai"
                cleanup_dna_bam_tmp() {{ rm -f -- "$tmp_bam" "$tmp_bai"; }}
                trap cleanup_dna_bam_tmp EXIT

                copy_bam_independent() {{
                    src="$1"
                    dst="$2"
                    if cp --reflink=auto "$src" "$dst" 2>/dev/null; then
                        echo "INFO: BAM reused with reflink/copy-on-write when supported." >> {log:q}
                    elif cp -c "$src" "$dst" 2>/dev/null; then
                        echo "INFO: BAM reused with APFS clonefile." >> {log:q}
                    else
                        cp "$src" "$dst"
                        echo "INFO: BAM reused with regular copy." >> {log:q}
                    fi
                }}

                if [ ! -s {input.high_names:q} ]; then
                    echo "INFO: no high-CpH reads detected; retaining the complete aligned BAM." >> {log:q}
                    copy_bam_independent {input.bam:q} "$tmp_bam"
                    cp {input.bai:q} "$tmp_bai"
                else
                    sam_extra=$(({threads} > 1 ? {threads} - 1 : 0))
                    high_names={input.high_names:q}
                    {params.samtools:q} view -@ "$sam_extra" -b \
                        -N "^$high_names" \
                        -o "$tmp_bam" \
                        {input.bam:q} \
                        >> {log:q} 2>&1
                    {params.samtools:q} index "$tmp_bam" >> {log:q} 2>&1
                fi

                {params.samtools:q} quickcheck -v "$tmp_bam" >> {log:q} 2>&1
                mv "$tmp_bam" {output.dna:q}
                mv "$tmp_bai" {output.dna_bai:q}
                trap - EXIT
                """


    if PUBLISH_RNA_BAM:
        rule bsconv_rna_bam:
            """SRD 恒定发布被 high-CpH 筛出的 BAM，作为 RNA 部分原始数据保留在 02_work/RNA。"""
            input:
                demux_completion = current_demux_completion,
                bam = CELL_PATH_PATTERN.post_alignment_bam,
                high_names = rules.high_cph_read_names.output.names
            output:
                rna_bam = RNA_BAM_OUTPUT,
                rna_bai = RNA_BAI_OUTPUT
            log:
                LOGS_DIR / "rules/biscuit/{demux_sample}_rna_bam.log"
            threads: HIGH_CPH_BAM_THREADS
            resources:
                mem_mb = lambda wildcards, attempt: static_resource_mem_mb(
                    "high_cph_bam", wildcards.demux_sample, attempt
                ),
                runtime = lambda wildcards, attempt: static_resource_runtime_min(
                    "high_cph_bam", wildcards.demux_sample, attempt
                ),
                attempt_no = lambda wildcards, attempt: int(attempt)
            params:
                samtools = SAMTOOLS,
                resource_log = lambda wc: static_resource_log("high_cph_bam", wc.demux_sample)
            conda: ENVIRONMENT_YAML
            shell:
                r"""
                set -euo pipefail
                source {JOB_RUNTIME:q}
                mkdir -p "$(dirname {output.rna_bam:q})" "$(dirname {log:q})"
                dna_pipeline_init_attempt_logs {resources.attempt_no} {log:q}
                printf '%s attempt=%s threads=%s mem_mb=%s runtime_min=%s\n' \
                    {params.resource_log:q} {resources.attempt_no} {threads} \
                    {resources.mem_mb} {resources.runtime} >> {log:q}
                tmp_bam={output.rna_bam:q}.tmp.$$
                cleanup_rna_bam_tmp() {{ rm -f -- "$tmp_bam" "$tmp_bam.bai"; }}
                trap cleanup_rna_bam_tmp EXIT

                sam_extra=$(({threads} > 1 ? {threads} - 1 : 0))
                high_names={input.high_names:q}
                if [ -s "$high_names" ]; then
                    {params.samtools:q} view -@ "$sam_extra" -b \
                        -N "$high_names" \
                        -o "$tmp_bam" {input.bam:q} \
                        >> {log:q} 2>&1
                else
                    {params.samtools:q} view -H {input.bam:q} | \
                        {params.samtools:q} view -@ "$sam_extra" -b -o "$tmp_bam" - \
                        >> {log:q} 2>&1
                fi
                {params.samtools:q} quickcheck -v "$tmp_bam" >> {log:q} 2>&1
                {params.samtools:q} index "$tmp_bam" >> {log:q} 2>&1
                python -m dna_pipeline atomic-publish \
                    --samtools {params.samtools:q} \
                    --bam-destination {output.rna_bam:q} \
                    --commit-last {output.rna_bam:q} \
                    --file "$tmp_bam.bai" {output.rna_bai:q} \
                    --file "$tmp_bam" {output.rna_bam:q} \
                    >> {log:q} 2>&1
                cleanup_rna_bam_tmp
                trap - EXIT
                """
    rule pileup:
        """对单个细胞的过滤后 BAM 执行 BISCUIT pileup，产出 bgzip VCF 与变体统计；零比对 cell 发布合法空 VCF。"""
        input:
            demux_completion = current_demux_completion,
            bam = get_pileup_bam,
            bai = get_pileup_bai,
            ref = REFERENCE_GENOME
        output:
            vcf = INTERMEDIATE_DIR / "biscuit" / "{demux_sample}.pileup.vcf.gz",
            stats = INTERMEDIATE_DIR / "biscuit" / "{demux_sample}.pileup_stats.json"
        log:
            LOGS_DIR / "rules/biscuit/{demux_sample}_pileup.log"
        threads: PILEUP_THREADS
        resources:
            mem_mb = lambda wildcards, attempt: static_resource_mem_mb(
                "pileup", wildcards.demux_sample, attempt
            ),
            runtime = lambda wildcards, attempt: static_resource_runtime_min(
                "pileup", wildcards.demux_sample, attempt
            ),
            attempt_no = lambda wildcards, attempt: int(attempt)
        params:
            biscuit = BISCUIT,
            samtools = SAMTOOLS,
            bgzip = BGZIP,
            bgzip_threads = 1,
            sample_name = lambda wc: wc.demux_sample.replace(os.sep, "_"),
            resource_log = lambda wc: static_resource_log("pileup", wc.demux_sample)
        conda: ENVIRONMENT_YAML
        shell:
            r"""
            set -euo pipefail
            source {JOB_RUNTIME:q}
            ulimit -n 65535 2>/dev/null || true
            ulimit -s unlimited 2>/dev/null || ulimit -s 65536 2>/dev/null || true
            mkdir -p "$(dirname {output.vcf:q})" "$(dirname {log:q})"
            dna_pipeline_init_attempt_logs {resources.attempt_no} {log:q}
            printf '%s attempt=%s threads=%s mem_mb=%s runtime_min=%s\n' \
                {params.resource_log:q} {resources.attempt_no} {threads} \
                {resources.mem_mb} {resources.runtime} >> {log:q}

            tmp_vcf={output.vcf:q}.tmp.$$.vcf.gz
            tmp_stats={output.stats:q}.tmp.$$
            tmp_count="${{tmp_stats}}.count"
            cleanup_pileup_tmp() {{ rm -f -- "$tmp_vcf" "$tmp_stats" "$tmp_count"; }}
            trap cleanup_pileup_tmp EXIT

            mapped_reads=$({params.samtools:q} idxstats {input.bam:q} | awk '{{n += $3}} END {{print n + 0}}')
            echo "INFO: mapped_reads=$mapped_reads" >> {log:q}
            variant_rows=0
            if [ "$mapped_reads" -eq 0 ]; then
                echo "WARNING: BAM has zero mapped reads; publishing a valid empty VCF." >> {log:q}
                printf '##fileformat=VCFv4.2\n#CHROM\tPOS\tID\tREF\tALT\tQUAL\tFILTER\tINFO\tFORMAT\tSAMPLE\n' | \
                    {params.bgzip:q} -@ {params.bgzip_threads} -c > "$tmp_vcf"
            else
                echo "INFO: stage=biscuit_pileup threads={threads}" >> {log:q}
                {params.biscuit:q} pileup -@ {threads} -m 40 -a 40 -l 20 {input.ref:q} {input.bam:q} 2>> {log:q} | \
                    awk -v count_file="$tmp_count" 'BEGIN{{n=0}} /^#/ {{print; next}} {{n++; print}} END{{print n > count_file}}' | \
                    {params.bgzip:q} -@ {params.bgzip_threads} -c > "$tmp_vcf"
                variant_rows="$(cat "$tmp_count")"
            fi
            dna_pipeline_write_pileup_stats "$tmp_stats" {params.sample_name:q} "$mapped_reads" "$variant_rows"
            echo "INFO: variant_records=$variant_rows" >> {log:q}

            {params.bgzip:q} -t "$tmp_vcf" >> {log:q} 2>&1
            mv "$tmp_vcf" {output.vcf:q}
            mv "$tmp_stats" {output.stats:q}
            rm -f -- "$tmp_count"

            trap - EXIT
            """
    rule generate_cpg_input:
        """将 BISCUIT pileup VCF 的 CpG calls 直接转换为 SnapATAC2 import_values 四列格式；零变体 cell 发布合法空表。"""
        input:
            demux_completion = current_demux_completion,
            vcf = rules.pileup.output.vcf,
            stats = rules.pileup.output.stats
        output:
            cpg = CELL_PATH_PATTERN.cpg
        log:
            LOGS_DIR / "rules/biscuit/{demux_sample}_cpg.log"
        threads: CPG_THREADS
        resources:
            mem_mb = lambda wildcards, attempt: static_resource_mem_mb(
                "generate_cpg_input", wildcards.demux_sample, attempt
            ),
            runtime = lambda wildcards, attempt: static_resource_runtime_min(
                "generate_cpg_input", wildcards.demux_sample, attempt
            ),
            attempt_no = lambda wildcards, attempt: int(attempt)
        params:
            biscuit = BISCUIT,
            zstd = ZSTD,
            resource_log = lambda wc: static_resource_log("generate_cpg_input", wc.demux_sample)
        conda: ENVIRONMENT_YAML
        shell:
            r"""
            set -euo pipefail
            source {JOB_RUNTIME:q}
            ulimit -n 65535 2>/dev/null || true
            ulimit -s unlimited 2>/dev/null || ulimit -s 65536 2>/dev/null || true
            mkdir -p "$(dirname {output.cpg:q})" "$(dirname {log:q})"
            dna_pipeline_init_attempt_logs {resources.attempt_no} {log:q}
            printf '%s attempt=%s threads=%s mem_mb=%s runtime_min=%s\n' \
                {params.resource_log:q} {resources.attempt_no} {threads} \
                {resources.mem_mb} {resources.runtime} >> {log:q}

            tmp_cpg={output.cpg:q}.tmp.$$.zst
            cleanup_cpg_tmp() {{ rm -f -- "$tmp_cpg"; }}
            trap cleanup_cpg_tmp EXIT
            variant_rows=$(dna_pipeline_pileup_stat {input.stats:q} variant_records)
            if [ "$variant_rows" -eq 0 ]; then
                dna_pipeline_emit_canonical_cpg {params.zstd:q} 0 "$tmp_cpg" < /dev/null
                echo "WARNING: pileup VCF has no records; publishing a header-only SnapATAC2 CpG table." >> {log:q}
            else
                {params.biscuit:q} vcf2bed -t cg -k 1 -c {input.vcf:q} 2>> {log:q} | \
                    dna_pipeline_emit_canonical_cpg {params.zstd:q} 0 "$tmp_cpg"
            fi
            {params.zstd:q} -q -t "$tmp_cpg" >> {log:q} 2>&1
            python -m dna_pipeline atomic-publish \
                --commit-last {output.cpg:q} \
                --file "$tmp_cpg" {output.cpg:q} \
                >> {log:q} 2>&1

            rm -f -- "$tmp_cpg"
            trap - EXIT
            """


    if GENERATE_SNP:
        rule generate_snp_input:
            """把 BISCUIT pileup VCF 转换为可选公开 SNP BED 并建立 tabix 索引。"""
            input:
                demux_completion = current_demux_completion,
                vcf = rules.pileup.output.vcf,
                stats = rules.pileup.output.stats
            output:
                snp = CELL_PATH_PATTERN.snp,
                tbi = CELL_PATH_PATTERN.snp_index
            log:
                LOGS_DIR / "rules/biscuit/{demux_sample}_snp.log"
            threads: SNP_THREADS
            resources:
                mem_mb = lambda wildcards, attempt: static_resource_mem_mb(
                    "generate_snp_input", wildcards.demux_sample, attempt
                ),
                runtime = lambda wildcards, attempt: static_resource_runtime_min(
                    "generate_snp_input", wildcards.demux_sample, attempt
                ),
                attempt_no = lambda wildcards, attempt: int(attempt)
            params:
                biscuit = BISCUIT,
                bgzip = BGZIP,
                tabix = TABIX,
                bgzip_threads = 1,
                resource_log = lambda wc: static_resource_log("generate_snp_input", wc.demux_sample)
            conda: ENVIRONMENT_YAML
            shell:
                r"""
                set -euo pipefail
                source {JOB_RUNTIME:q}
                mkdir -p "$(dirname {output.snp:q})" "$(dirname {log:q})"
                dna_pipeline_init_attempt_logs {resources.attempt_no} {log:q}
                printf '%s attempt=%s threads=%s mem_mb=%s runtime_min=%s\n' \
                    {params.resource_log:q} {resources.attempt_no} {threads} \
                    {resources.mem_mb} {resources.runtime} >> {log:q}
                tmp_snp={output.snp:q}.tmp.$$.bed.gz
                tmp_tbi="$tmp_snp.tbi"
                cleanup_snp_tmp() {{ rm -f -- "$tmp_snp" "$tmp_tbi"; }}
                trap cleanup_snp_tmp EXIT

                variant_rows=$(dna_pipeline_pileup_stat {input.stats:q} variant_records)
                if [ "$variant_rows" -eq 0 ]; then
                    echo "WARNING: pileup VCF has no records; publishing an empty SNP BED." >> {log:q}
                    : | {params.bgzip:q} -@ {params.bgzip_threads} -c > "$tmp_snp"
                else
                    {params.biscuit:q} vcf2bed -t snp {input.vcf:q} 2>> {log:q} | \
                        {params.bgzip:q} -@ {params.bgzip_threads} -c > "$tmp_snp"
                fi
                {params.bgzip:q} -t "$tmp_snp" >> {log:q} 2>&1
                {params.tabix:q} -f -p bed "$tmp_snp" >> {log:q} 2>&1
                mv "$tmp_snp" {output.snp:q}
                mv "$tmp_tbi" {output.tbi:q}

                trap - EXIT
                """
    rule biscuit_qc:
        """对单个细胞的 post-dedup BAM 运行 biscuit qc，并基于 pileup VCF 补齐碱基平均 conversion 表；零比对 cell 发布合法空报告。"""
        input:
            demux_completion = current_demux_completion,
            dna_bam = CELL_PATH_PATTERN.post_alignment_bam,
            dna_bai = CELL_PATH_PATTERN.post_alignment_bam_index,
            vcf = rules.pileup.output.vcf,
            stats = rules.pileup.output.stats,
            ref = REFERENCE_GENOME
        output:
            strand = update(CELL_PATH_PATTERN.biscuit_qc_source("strand_table.txt")),
            read_conversion = update(CELL_PATH_PATTERN.biscuit_qc_source("totalReadConversionRate.txt")),
            cpg_retention = update(CELL_PATH_PATTERN.biscuit_qc_source("CpGRetentionByReadPos.txt")),
            mapq = update(CELL_PATH_PATTERN.biscuit_qc_source("mapq_table.txt")),
            base_conversion = update(CELL_PATH_PATTERN.biscuit_qc_source("totalBaseConversionRate.txt")),
            cph_retention = update(CELL_PATH_PATTERN.biscuit_qc_source("CpHRetentionByReadPos.txt")),
            isize = update(CELL_PATH_PATTERN.biscuit_qc_source("isize_table.txt")),
            dup_report = update(CELL_PATH_PATTERN.biscuit_qc_source("dup_report.txt"))
        log:
            LOGS_DIR / "rules/biscuit_qc/{demux_sample}.log"
        threads: BISCUIT_QC_THREADS
        resources:
            mem_mb = lambda wildcards, attempt: static_resource_mem_mb(
                "biscuit_qc", wildcards.demux_sample, attempt
            ),
            runtime = lambda wildcards, attempt: static_resource_runtime_min(
                "biscuit_qc", wildcards.demux_sample, attempt
            ),
            attempt_no = lambda wildcards, attempt: int(attempt)
        conda: ENVIRONMENT_YAML
        params:
            sample_name = lambda wc: wc.demux_sample.replace(os.sep, "_"),
            biscuit = BISCUIT,
            samtools = SAMTOOLS,
            abs_qc_dir = lambda wc: os.path.abspath(
                str(PROJECT_LAYOUT.cell(wc.demux_sample).biscuit_qc_dir)
            ),
            abs_ref = lambda wc, input: os.path.abspath(str(input.ref)),
            abs_bam = lambda wc, input: os.path.abspath(str(input.dna_bam)),
            abs_vcf = lambda wc, input: os.path.abspath(str(input.vcf)),
            resource_log = lambda wc: static_resource_log("biscuit_qc", wc.demux_sample)
        shell:
            r"""
            set -euo pipefail
            source {JOB_RUNTIME:q}
            ulimit -n 65535 2>/dev/null || true
            ulimit -s unlimited 2>/dev/null || ulimit -s 65536 2>/dev/null || true
            mkdir -p "$(dirname {params.abs_qc_dir:q})" "$(dirname {log:q})"
            dna_pipeline_init_attempt_logs {resources.attempt_no} {log:q}
            printf '%s attempt=%s threads=%s mem_mb=%s runtime_min=%s\n' \
                {params.resource_log:q} {resources.attempt_no} {threads} \
                {resources.mem_mb} {resources.runtime} >> {log:q}
            [ -f {input.dna_bai:q} ] || (printf 'BAM index not found: %s\n' {input.dna_bai:q} >&2; exit 1)

            qc_tmp={params.abs_qc_dir:q}.new
            qc_backup={params.abs_qc_dir:q}.backup
            qc_absent="${{qc_backup}}.absent"
            publish_in_progress=0

            restore_qc_generation() {{
                if [ -d "$qc_backup" ]; then
                    rm -rf -- {params.abs_qc_dir:q}
                    mv "$qc_backup" {params.abs_qc_dir:q}
                    rm -f -- "$qc_absent"
                elif [ -f "$qc_absent" ]; then
                    rm -rf -- {params.abs_qc_dir:q}
                    rm -f -- "$qc_absent"
                fi
            }}

            if [ -d "$qc_backup" ] || [ -f "$qc_absent" ]; then
                restore_qc_generation
            fi
            rm -rf -- "$qc_tmp"
            mkdir -m 700 "$qc_tmp"
            cleanup_qc_tmp() {{
                exit_status=$?
                rm -rf -- "$qc_tmp"
                if (( publish_in_progress == 1 )); then
                    restore_qc_generation || true
                fi
                return "$exit_status"
            }}
            trap cleanup_qc_tmp EXIT
            sample_name={params.sample_name:q}

            read -r mapped_reads unmapped_reads <<EOF_STATS
    $({params.samtools:q} idxstats {params.abs_bam:q} | awk '{{m += $3; u += $4}} END {{print m + 0, u + 0}}')
EOF_STATS
            total_reads=$((mapped_reads + unmapped_reads))
            {{
                echo "BISCUIT native QC"
                echo "sample=$sample_name"
                echo "total_reads=$total_reads"
                echo "mapped_reads=$mapped_reads"
                {params.biscuit:q} version || true
            }} >> {log:q} 2>&1

            if [ "$mapped_reads" -gt 0 ]; then
                {params.biscuit:q} qc \
                    {params.abs_ref:q} \
                    {params.abs_bam:q} \
                    "$qc_tmp/$sample_name" \
                    >> {log:q} 2>&1
            else
                echo "WARNING: BAM contains zero mapped reads; skipping biscuit qc." >> {log:q}
                cat > "$qc_tmp/${{sample_name}}_strand_table.txt" <<'EOF_STRAND'
BISCUITqc Strand Table
Strand Distribution:
strand\BS      BSW (f)      BSC (r)
     R1 (f):   0            0
     R1 (r):   0            0
EOF_STRAND
                cat > "$qc_tmp/${{sample_name}}_totalReadConversionRate.txt" <<'EOF_READ_CONV'
BISCUITqc Conversion Rate by Read Average Table
CpA	CpC	CpG	CpT
-1	-1	-1	-1
EOF_READ_CONV
                cat > "$qc_tmp/${{sample_name}}_CpGRetentionByReadPos.txt" <<'EOF_CPG'
BISCUITqc CpG Retention by Read Position Table
ReadInPair	Position	Conversion/Retention	Count
EOF_CPG
                cat > "$qc_tmp/${{sample_name}}_CpHRetentionByReadPos.txt" <<'EOF_CPH'
BISCUITqc CpH Retention by Read Position Table
ReadInPair	Position	Conversion/Retention	Count
EOF_CPH
                cat > "$qc_tmp/${{sample_name}}_mapq_table.txt" <<EOF_MAPQ
BISCUITqc Mapping Quality Table
MapQ	Count
unmapped	$unmapped_reads
EOF_MAPQ
                cat > "$qc_tmp/${{sample_name}}_isize_table.txt" <<'EOF_ISIZE'
BISCUITqc Insert Size Table
InsertSize	Fraction	ReadCount
EOF_ISIZE
                cat > "$qc_tmp/${{sample_name}}_dup_report.txt" <<EOF_DUP
BISCUITqc Read Duplication Table
Number of duplicate reads:	0
Number of reads:	$total_reads
Number of duplicate q40-reads:	0
Number of q40-reads:	0
EOF_DUP
            fi

            base_conv="$qc_tmp/${{sample_name}}_totalBaseConversionRate.txt"
            echo "BISCUITqc Conversion Rate by Base Average Table" > "$base_conv"
            variant_rows=$(dna_pipeline_pileup_stat {input.stats:q} variant_records)
            if [ "$variant_rows" -eq 0 ]; then
                printf 'CA\tCC\tCG\tCT\n-1\t-1\t-1\t-1\n' >> "$base_conv"
            else
                {params.biscuit:q} vcf2bed -e -t c {params.abs_vcf:q} 2>> {log:q} | \
                awk '{{ beta_sum[$6] += $8; beta_cnt[$6] += 1 }} END {{
                    print "CA\tCC\tCG\tCT"
                    ca = (beta_cnt["CA"] < 20) ? -1 : beta_sum["CA"] / beta_cnt["CA"]
                    cc = (beta_cnt["CC"] < 20) ? -1 : beta_sum["CC"] / beta_cnt["CC"]
                    cg = (beta_cnt["CG"] < 20) ? -1 : beta_sum["CG"] / beta_cnt["CG"]
                    ct = (beta_cnt["CT"] < 20) ? -1 : beta_sum["CT"] / beta_cnt["CT"]
                    print ca "\t" cc "\t" cg "\t" ct
                }}' >> "$base_conv"
            fi

            for suffix in \
                strand_table.txt \
                totalReadConversionRate.txt \
                CpGRetentionByReadPos.txt \
                mapq_table.txt \
                totalBaseConversionRate.txt \
                CpHRetentionByReadPos.txt \
                isize_table.txt \
                dup_report.txt; do
                test -s "$qc_tmp/${{sample_name}}_${{suffix}}" || {{
                    echo "ERROR: BISCUIT QC did not produce ${{sample_name}}_${{suffix}}" >> {log:q}
                    exit 1
                }}
            done

            if [ -d {params.abs_qc_dir:q} ]; then
                mv {params.abs_qc_dir:q} "$qc_backup"
            else
                : > "$qc_absent"
            fi
            publish_in_progress=1
            if ! mv "$qc_tmp" {params.abs_qc_dir:q}; then
                restore_qc_generation
                publish_in_progress=0
                exit 1
            fi
            publish_in_progress=0
            rm -rf -- "$qc_backup"
            rm -f -- "$qc_absent"
            trap - EXIT
            """
elif METHYLATION_BACKEND == "rastair":
    rule taps_align_mark:
        """复用 Cabernet trimming，以 BWA 比对并标记重复，保留全部原始测得的比对记录。"""
        input:
            r1 = lambda wc: current_demux_fastq(wc.demux_sample, 1),
            r2 = lambda wc: current_demux_fastq(wc.demux_sample, 2),
            demux_sources = current_demux_source_inputs,
            reference = REFERENCE_BACKEND_DEPENDENCIES,
            helper = str(BSCONV_MODULE_CODE),
        output:
            report = CELL_PATH_PATTERN.cutadapt_json,
            bam = CELL_PATH_PATTERN.marked_bam if KEEP_FINAL_BAM else temp(CELL_PATH_PATTERN.marked_bam),
            bai = CELL_PATH_PATTERN.marked_bam_index if KEEP_FINAL_BAM else temp(CELL_PATH_PATTERN.marked_bam_index),
            qc = INTERMEDIATE_DIR / "rastair/{demux_sample}.alignment_qc.json",
        log:
            main = LOGS_DIR / "rules/rastair/{demux_sample}_align.log",
            cutadapt = LOGS_DIR / "rules/cutadapt/{demux_sample}.log",
        threads: lambda wc: backend_stage_threads("rastair", "align", wc)
        resources:
            mem_mb = lambda wc, attempt: backend_stage_mem_mb("rastair", "align", wc.demux_sample, attempt),
            runtime = lambda wc, attempt: backend_preprocess_runtime_min("rastair", wc.demux_sample, attempt),
            disk_mb = lambda wc: static_scratch_mb("preprocess_alignment", wc.demux_sample),
            attempt_no = lambda wc, attempt: int(attempt),
        params:
            demux_spacer_len = DNA_W_SPACER_LEN,
            calling_identity = DROPLET_CALLING_IDENTITY,
            demux_mode = lambda wc: DEMUX_RUN_ROUTES[current_demux_match(wc.demux_sample)[0].parent.name].demux_mode,
            bwa_prefix = f"{REFERENCE_GENOME}.bwa/genome",
            rg = lambda wc: "@RG\\tID:{0}\\tSM:{0}\\tPL:ILLUMINA".format(wc.demux_sample),
            trim_threads = CUTADAPT_THREADS,
            quality = CUTADAPT_QUALITY_CUTOFF,
            min_length = CUTADAPT_MIN_LENGTH,
            adapter1 = lambda wc: CUTADAPT_ADAPTER_R1_SPEC,
            adapter2 = lambda wc: CUTADAPT_ADAPTER_R2_SPEC,
        conda: ENVIRONMENT_YAML
        shell:
            r"""
            set -euo pipefail
            source {JOB_RUNTIME:q}
            export PYTHONPATH="$DNA_PIPELINE_ROOT/core"
            mkdir -p "$(dirname {output.bam:q})" "$(dirname {output.report:q})" "$(dirname {log.main:q})" "$(dirname {log.cutadapt:q})"
            dna_pipeline_init_attempt_logs {resources.attempt_no} {log.main:q} {log.cutadapt:q}
            exec >> {log.main:q} 2>&1
            printf 'stage=taps_align_mark attempt=%s threads=%s mem_mb=%s runtime_min=%s scratch_mb=%s\n' \
                {resources.attempt_no} {threads} {resources.mem_mb} {resources.runtime} {resources.disk_mb}
            dna_pipeline_allocate_scratch {NODE_TMPDIR:q} {SCRATCH_NAMESPACE:q} preprocess_alignment \
                {wildcards.demux_sample:q} {resources.disk_mb} {PROJECT_DIR:q}
            dna_pipeline_install_scratch_cleanup
            tmpdir="$DNA_PIPELINE_SCRATCH_DIR"
            dna_pipeline_log_scratch
            dna_pipeline_run_cutadapt {CUTADAPT:q} {GZIP:q} {params.trim_threads} \
                {params.quality:q} {params.min_length} {params.adapter1:q} {params.adapter2:q} \
                {input.r1:q} {input.r2:q} "$tmpdir/R1.fastq.gz" "$tmpdir/R2.fastq.gz" "$tmpdir/cutadapt.json" {log.cutadapt:q}
            bwa_threads=$(({threads} > 1 ? {threads} - 1 : 1))
            io_threads=$(({threads} - 1))
            sort_mem=$(({resources.mem_mb} / ({threads} + 1)))
            {BWA:q} mem -Y -t "$bwa_threads" -R {params.rg:q} {params.bwa_prefix:q} "$tmpdir/R1.fastq.gz" "$tmpdir/R2.fastq.gz" | \
                {SAMTOOLS:q} view -u -o "$tmpdir/aligned.bam" -
            rm -f -- "$tmpdir/R1.fastq.gz" "$tmpdir/R2.fastq.gz"
            {SAMTOOLS:q} collate -@ "$io_threads" -o "$tmpdir/names.bam" -T "$tmpdir/collate" "$tmpdir/aligned.bam"
            rm -f -- "$tmpdir/aligned.bam"
            {SAMTOOLS:q} fixmate -m -@ "$io_threads" "$tmpdir/names.bam" "$tmpdir/fixmate.bam"
            rm -f -- "$tmpdir/names.bam"
            {SAMTOOLS:q} sort -@ "$io_threads" -m "${{sort_mem}}M" -T "$tmpdir/sort" -o "$tmpdir/sorted.bam" "$tmpdir/fixmate.bam"
            rm -f -- "$tmpdir/fixmate.bam"
            {SAMTOOLS:q} markdup -S -s -@ "$io_threads" -T "$tmpdir/markdup" "$tmpdir/sorted.bam" "$tmpdir/marked.bam"
            rm -f -- "$tmpdir/sorted.bam"
            {SAMTOOLS:q} index -@ "$io_threads" "$tmpdir/marked.bam"
            {RASTAIR_PYTHON:q} -m dna_pipeline taps-alignment-qc --bam "$tmpdir/marked.bam" \
                --samtools {SAMTOOLS:q} --scratch "$tmpdir" --sample={wildcards.demux_sample:q} --output "$tmpdir/qc.json"
            python -m dna_pipeline atomic-publish --commit-last {output.qc:q} \
                --bam-destination {output.bam:q} --samtools {SAMTOOLS:q} \
                --file "$tmpdir/cutadapt.json" {output.report:q} \
                --file "$tmpdir/marked.bam" {output.bam:q} --file "$tmpdir/marked.bam.bai" {output.bai:q} \
                --file "$tmpdir/qc.json" {output.qc:q}
            dna_pipeline_release_scratch
            """

    rule taps_call_cpg:
        """调用 TAPS 的 5mC＋5hmC，按参考基因型导出 canonical 整数 CpG 及对照 QC。"""
        input:
            bam = CELL_PATH_PATTERN.marked_bam,
            bai = CELL_PATH_PATTERN.marked_bam_index,
            qc = rules.taps_align_mark.output.qc,
            reference = REFERENCE_GENOME,
            helper = str(BSCONV_MODULE_CODE),
            fai = str(REFERENCE_FAI),
        output:
            cpg = CELL_PATH_PATTERN.cpg,
            qc = CELL_PATH_PATTERN.rastair_qc,
        log:
            LOGS_DIR / "rules/rastair/{demux_sample}_call.log"
        threads: 1
        resources:
            mem_mb = lambda wc, attempt: static_resource_mem_mb("pileup", wc.demux_sample, attempt),
            runtime = lambda wc, attempt: static_resource_runtime_min("pileup", wc.demux_sample, attempt),
            disk_mb = lambda wc: static_scratch_mb("preprocess_alignment", wc.demux_sample),
            attempt_no = lambda wc, attempt: int(attempt),
        conda: ENVIRONMENT_YAML
        shell:
            r"""
            set -euo pipefail
            source {JOB_RUNTIME:q}
            export PYTHONPATH="$DNA_PIPELINE_ROOT/core"
            mkdir -p "$(dirname {output.cpg:q})" "$(dirname {log:q})"
            dna_pipeline_init_attempt_logs {resources.attempt_no} {log:q}
            exec >> {log:q} 2>&1
            printf 'stage=taps_call_cpg attempt=%s threads=%s mem_mb=%s runtime_min=%s\n' \
                {resources.attempt_no} {threads} {resources.mem_mb} {resources.runtime}
            dna_pipeline_allocate_scratch {NODE_TMPDIR:q} {SCRATCH_NAMESPACE:q} preprocess_alignment \
                {wildcards.demux_sample:q} {resources.disk_mb} {PROJECT_DIR:q}
            dna_pipeline_install_scratch_cleanup
            tmpdir="$DNA_PIPELINE_SCRATCH_DIR"
            {RASTAIR:q} call -@ {threads} -r {input.reference:q} --guess-read-orientation \
                -q {TAPS_MIN_MAPQ} -Q {TAPS_MIN_BASEQ} -f {TAPS_INCLUDE_FLAGS} -F {TAPS_EXCLUDE_FLAGS} \
                --cpgs-only --all --m-min-depth 1 --nOT 0,0,0,0 --nOB 0,0,0,0 \
                --bed "$tmpdir/native.bed" {input.bam:q}
            {RASTAIR_PYTHON:q} -m dna_pipeline rastair-cpg --bed "$tmpdir/native.bed" --reference {input.reference:q} \
                --alignment-qc {input.qc:q} --output-qc "$tmpdir/qc.json" | \
                dna_pipeline_emit_canonical_cpg {ZSTD:q} 0 "$tmpdir/cpg.tsv.zst"
            {ZSTD:q} -q -t "$tmpdir/cpg.tsv.zst"
            python -m dna_pipeline atomic-publish --commit-last {output.qc:q} \
                --file "$tmpdir/cpg.tsv.zst" {output.cpg:q} --file "$tmpdir/qc.json" {output.qc:q}
            dna_pipeline_release_scratch
            """

else:
    rule bismark_align_dedup:
        """在单个 scratch 作业内完成 Cutadapt、Bismark 比对与 paired-end 去重。"""
        group: "bismark_cell" if PROTOCOL_POLICY.name in {"cabernet", "droplet"} else None
        input:
            r1 = lambda wc: current_demux_fastq(wc.demux_sample, 1),
            r2 = lambda wc: current_demux_fastq(wc.demux_sample, 2),
            demux_sources = current_demux_source_inputs,
            ref = REFERENCE_GENOME,
            ref_fai = str(REFERENCE_FAI),
            bismark_genome = str(REFERENCE_BISMARK_GENOME),
            bismark_indexes = [str(path) for path in REFERENCE_BISMARK_INDEX_PATHS]
        output:
            report = CELL_PATH_PATTERN.cutadapt_json,
            bam = temp(CELL_PATH_PATTERN.post_alignment_bam),
            align_report = CELL_PATH_PATTERN.bismark_align_report,
            dedup_report = CELL_PATH_PATTERN.droplet_umi_qc if PROTOCOL_POLICY.name == "droplet" else CELL_PATH_PATTERN.bismark_dedup_report
        log:
            LOGS_DIR / "rules/bismark/{demux_sample}_align.log"
        threads: BISMARK_ALIGN_THREADS
        resources:
            mem_mb = lambda wildcards, attempt: backend_stage_mem_mb("bismark", "align", wildcards.demux_sample, attempt),
            runtime = lambda wildcards, attempt: BISMARK_CELL_RULE_RUNTIME_MIN if PROTOCOL_POLICY.name in {"cabernet", "droplet"} else backend_preprocess_runtime_min("bismark", wildcards.demux_sample, attempt),
            disk_mb = lambda wildcards: static_scratch_mb("preprocess_alignment", wildcards.demux_sample),
            attempt_no = lambda wildcards, attempt: int(attempt)
        params:
            demux_spacer_len = DNA_W_SPACER_LEN,
            calling_identity = DROPLET_CALLING_IDENTITY,
            demux_mode = lambda wc: DEMUX_RUN_ROUTES[current_demux_match(wc.demux_sample)[0].parent.name].demux_mode,
            cutadapt = CUTADAPT,
            cutadapt_threads = CUTADAPT_THREADS,
            cutadapt_quality = CUTADAPT_QUALITY_CUTOFF,
            cutadapt_min_length = CUTADAPT_MIN_LENGTH,
            adapter_r1_spec = lambda wc: CUTADAPT_ADAPTER_R1_SPEC,
            adapter_r2_spec = lambda wc: CUTADAPT_ADAPTER_R2_SPEC,
            bismark = BISMARK,
            protocol = PROTOCOL_POLICY.name,
            umi_tools = str(Path(BISMARK).parent / "umi_tools"),
            umi_identity = DROPLET_UMI_IDENTITY,
            bowtie2_dir = str(Path(BOWTIE2).parent),
            alignment_instances = BISMARK_ALIGNMENT_INSTANCES,
            library_flag = BISMARK_LIBRARY_FLAG,
            alignment_flag = BISMARK_ALIGNMENT_FLAG,
            score_min = BISMARK_SCORE_MIN,
            local_alignment_flag = BISMARK_LOCAL_ALIGNMENT_FLAG,
            seed_mismatches = BISMARK_SEED_MISMATCHES,
            seed_length = BISMARK_SEED_LENGTH,
            effort_d = BISMARK_EFFORT_D,
            reseed_r = BISMARK_RESEED_R,
            samtools = SAMTOOLS,
            local_tmp = NODE_TMPDIR,
            scratch_namespace = SCRATCH_NAMESPACE,
            resource_log = lambda wc: backend_stage_resource_log(
                "bismark", "align", wc.demux_sample
            )
        conda: ENVIRONMENT_YAML
        shell:
            r"""
            set -euo pipefail
            source {JOB_RUNTIME:q}
            mkdir -p "$(dirname {output.bam:q})" "$(dirname {output.align_report:q})" "$(dirname {log:q})"
            dna_pipeline_init_attempt_logs {resources.attempt_no} {log:q}
            printf '%s attempt=%s threads=%s mem_mb=%s runtime_min=%s scratch_mb=%s\n' \
                {params.resource_log:q} {resources.attempt_no} {threads} \
                {resources.mem_mb} {resources.runtime} {resources.disk_mb} >> {log:q}
            exec 2>> {log:q}
            dna_pipeline_allocate_scratch {params.local_tmp:q} {params.scratch_namespace:q} preprocess_alignment {wildcards.demux_sample:q} {resources.disk_mb} {PROJECT_DIR:q}
            dna_pipeline_install_scratch_cleanup
            dna_pipeline_log_scratch >> {log:q} 2>&1
            tmpdir="$DNA_PIPELINE_SCRATCH_DIR"; out="$tmpdir/bismark"; mkdir -p "$out"
            r1="$tmpdir/trim.1.fastq.gz"; r2="$tmpdir/trim.2.fastq.gz"; cj="$tmpdir/cutadapt.json"
            dna_pipeline_run_cutadapt \
                {params.cutadapt:q} {GZIP:q} {params.cutadapt_threads} \
                {params.cutadapt_quality:q} {params.cutadapt_min_length} \
                {params.adapter_r1_spec:q} {params.adapter_r2_spec:q} \
                {input.r1:q} {input.r2:q} "$r1" "$r2" "$cj" {log:q}
            bthreads=$(( {threads} / {params.alignment_instances} ))
            (( bthreads >= 1 )) || bthreads=1
            set --
            if (( bthreads >= 2 )); then
                set -- -p "$bthreads"
            fi
            echo "INFO: stage=bismark_align allocated_threads={threads} alignment_instances={params.alignment_instances} bowtie_threads_per_instance=$bthreads" >> {log:q}
            {params.bismark:q} align \
                --genome "$(dirname {input.bismark_genome:q})" \
                --path_to_bowtie2 {params.bowtie2_dir:q} \
                --basename {wildcards.demux_sample:q} \
                --output_dir "$out" --temp_dir "$tmpdir" \
                "$@" {params.alignment_flag} {params.library_flag} {params.local_alignment_flag} \
                --score_min {params.score_min:q} \
                --seedmms {params.seed_mismatches} --seedlen {params.seed_length} \
                -D {params.effort_d} -R {params.reseed_r} \
                -1 "$r1" -2 "$r2" >> {log:q} 2>&1
            align_bam=$(dna_pipeline_find_single_output "$out" --exclude-glob '*deduplicated*' '*.bam')
            align_report=$(dna_pipeline_find_single_output "$out" '*PE_report.txt' '*SE_report.txt')
            {params.samtools:q} quickcheck -v "$align_bam" >> {log:q} 2>&1
            test -s "$align_report"

            dedup_threads=$(( {threads} < 4 ? {threads} : 4 ))
            if [[ {params.protocol:q} == droplet ]]; then
                final_bam="$out/droplet.deduplicated.bam"
                dedup_report="$out/droplet.umi_dedup.json"
                python -m dna_pipeline dedup-droplet-bam --bam "$align_bam" --output "$final_bam" \
                    --qc "$dedup_report" --sample={wildcards.demux_sample:q} --scratch "$tmpdir" --umi-tools {params.umi_tools:q} \
                    --threads "$dedup_threads" >> {log:q} 2>&1
            else
                {params.bismark:q} dedup --bam -p --parallel "$dedup_threads" --output_dir "$out" -o {wildcards.demux_sample:q} "$align_bam" >> {log:q} 2>&1
                final_bam=$(dna_pipeline_find_single_output "$out" '*.deduplicated.bam')
                dedup_report=$(dna_pipeline_find_single_output "$out" '*deduplication_report.txt')
            fi
            test -s "$dedup_report"
            {params.samtools:q} quickcheck -v "$final_bam" >> {log:q} 2>&1
            python -m dna_pipeline atomic-publish \
                --samtools {params.samtools:q} \
                --bam-destination {output.bam:q} \
                --commit-last {output.bam:q} \
                --file "$cj" {output.report:q} \
                --file "$align_report" {output.align_report:q} \
                --file "$dedup_report" {output.dedup_report:q} \
                --file "$final_bam" {output.bam:q} \
                >> {log:q} 2>&1
            dna_pipeline_release_scratch
            """
    rule bismark_filter_nonconversion:
        """执行 bismark filter 非 CG（non-CG）评估/过滤，并保持输出 BAM 中 read pair 相邻。"""
        group: "bismark_cell" if PROTOCOL_POLICY.name in {"cabernet", "droplet"} else None
        input:
            demux_completion = current_demux_completion,
            bam = rules.bismark_align_dedup.output.bam
        output:
            bam = temp(CELL_PATH_PATTERN.processed_bam) if not KEEP_FINAL_BAM else CELL_PATH_PATTERN.processed_bam,
            removed = temp(CELL_PATH_PATTERN.removed_bam) if PUBLISH_RNA_BAM else [],
            summary = CELL_PATH_PATTERN.high_cph_summary,
            mqc = temp(CELL_PATH_PATTERN.high_cph_multiqc),
        log:
            LOGS_DIR / "rules/bismark/{demux_sample}_filter.log"
        threads: HIGH_CPH_READ_NAMES_THREADS
        resources:
            mem_mb = lambda wildcards, attempt: static_resource_mem_mb(
                "high_cph_read_names", wildcards.demux_sample, attempt
            ),
            runtime = lambda wildcards, attempt: BISMARK_CELL_RULE_RUNTIME_MIN if PROTOCOL_POLICY.name in {"cabernet", "droplet"} else combined_static_runtime_min(
                HIGH_CPH_FILTER_RULES, wildcards.demux_sample, attempt
            ),
            disk_mb = lambda wildcards: static_scratch_mb(
                "high_cph_filter", wildcards.demux_sample
            ),
            attempt_no = lambda wildcards, attempt: int(attempt)
        params:
            bismark = BISMARK,
            samtools = SAMTOOLS,
            excluded_contigs_json = HIGH_CPH_EXCLUDED_CONTIGS_JSON,
            percentage = BISMARK_NONCONVERSION_PERCENTAGE_CUTOFF,
            minimum = BISMARK_NONCONVERSION_MIN_COUNT,
            publish_removed = "true" if PUBLISH_RNA_BAM else "false",
            protocol = PROTOCOL_POLICY.name,
            high_cph_role = PROTOCOL_POLICY.high_cph_role,
            python = _rule_executable("python"),
            local_tmp = NODE_TMPDIR,
            scratch_namespace = SCRATCH_NAMESPACE,
            resource_log = lambda wc: static_resource_log(
                "high_cph_read_names", wc.demux_sample
            )
        conda: ENVIRONMENT_YAML
        shell:
            r"""
            set -euo pipefail
            source {JOB_RUNTIME:q}
            mkdir -p "$(dirname {output.bam:q})" "$(dirname {log:q})"
            dna_pipeline_init_attempt_logs {resources.attempt_no} {log:q}
            printf '%s attempt=%s threads=%s mem_mb=%s runtime_min=%s scratch_mb=%s\n' \
                {params.resource_log:q} {resources.attempt_no} {threads} \
                {resources.mem_mb} {resources.runtime} {resources.disk_mb} >> {log:q}
            exec 2>> {log:q}
            dna_pipeline_allocate_scratch \
                {params.local_tmp:q} {params.scratch_namespace:q} \
                high_cph_filter \
                {wildcards.demux_sample:q} {resources.disk_mb} {PROJECT_DIR:q}
            dna_pipeline_install_scratch_cleanup
            tmp="$DNA_PIPELINE_SCRATCH_DIR"
            dna_pipeline_log_scratch >> {log:q} 2>&1

            filter_dir="$tmp/filter"
            mkdir -p "$filter_dir"
            {params.python:q} -m dna_pipeline split-bismark-pairs \
                --input-bam {input.bam:q} \
                --excluded-contigs-json {params.excluded_contigs_json:q} \
                --bio "$filter_dir/input.bam" --excluded "$tmp/excluded.bam" \
                > "$tmp/pair_counts.txt"
            read -r candidate_pairs excluded_pairs < "$tmp/pair_counts.txt"
            removed_pairs=0
            filtered="$filter_dir/input.bam"
            removed="$filtered"

            if (( candidate_pairs > 0 )); then
                (
                    cd "$filter_dir"
                    {params.bismark:q} filter -p \
                        --percentage_cutoff {params.percentage} \
                        --minimum_count {params.minimum} \
                        input.bam
                ) >> {log:q} 2>&1
                filtered=$(dna_pipeline_find_single_output "$filter_dir" --recursive '*nonCG_filtered*.bam')
                removed=$(dna_pipeline_find_single_output "$filter_dir" --recursive '*nonCG_removed*.bam')
                removed_aln=$({params.samtools:q} view -c "$removed")
                (( removed_aln % 2 == 0 )) || {{
                    echo "ERROR: Bismark non-CG removed BAM contains an odd alignment count" >&2
                    exit 1
                }}
                removed_pairs=$((removed_aln / 2))
            fi
            {params.samtools:q} quickcheck -v "$filtered" "$removed" >> {log:q} 2>&1

            main_bio="$filtered"
            if (( excluded_pairs > 0 )); then
                {params.samtools:q} cat -o "$tmp/processed.bam" "$main_bio" "$tmp/excluded.bam" >> {log:q} 2>&1
            elif (( candidate_pairs == 0 )) && {params.publish_removed}; then
                cp "$main_bio" "$tmp/processed.bam"
            else
                mv "$main_bio" "$tmp/processed.bam"
            fi
            {params.samtools:q} quickcheck -v "$tmp/processed.bam" >> {log:q} 2>&1
            export PYTHONPATH="$DNA_PIPELINE_ROOT/core"
            python -m dna_pipeline write-filter-summary \
                --sample={wildcards.demux_sample:q} \
                --candidate-pairs "$candidate_pairs" --removed-pairs "$removed_pairs" \
                --excluded-pairs "$excluded_pairs" \
                --processed-bam "$tmp/processed.bam" --samtools {params.samtools:q} \
                --percentage {params.percentage} --minimum-count {params.minimum} \
                --protocol {params.protocol:q} --high-cph-role {params.high_cph_role:q} \
                --summary-path "$tmp/summary.json" --multiqc-path "$tmp/mqc.json" >> {log:q} 2>&1

            if {params.publish_removed}; then
                python -m dna_pipeline atomic-publish \
                    --samtools {params.samtools:q} \
                    --bam-destination {output.bam:q} \
                    --commit-last {output.bam:q} \
                    --file "$tmp/summary.json" {output.summary:q} \
                    --file "$tmp/mqc.json" {output.mqc:q} \
                    --file "$removed" {output.removed:q} \
                    --file "$tmp/processed.bam" {output.bam:q} \
                    >> {log:q} 2>&1
            else
                python -m dna_pipeline atomic-publish \
                    --samtools {params.samtools:q} \
                    --bam-destination {output.bam:q} \
                    --commit-last {output.bam:q} \
                    --file "$tmp/summary.json" {output.summary:q} \
                    --file "$tmp/mqc.json" {output.mqc:q} \
                    --file "$tmp/processed.bam" {output.bam:q} \
                    >> {log:q} 2>&1
            fi
            dna_pipeline_release_scratch
            """


    if PUBLISH_RNA_BAM:
        rule bismark_publish_rna_bam:
            """SRD 恒定把被 non-CG 筛出的 BAM 排序索引后保留到 02_work/RNA/BAM。"""
            input:
                bam = rules.bismark_filter_nonconversion.output.removed
            output:
